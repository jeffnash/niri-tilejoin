+/// Connectors to stitch into one logical tiled output, e.g. a dual-SST 5K panel connected
+/// over two DisplayPort links.
+///
+/// Written as a child of an `output` block: `tiled-group "DP-4" "DP-5"`. The output block's
+/// settings (scale, position, ...) apply to the resulting stitched output. The first connector
+/// listed is the leftmost tile.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TiledGroup(pub Vec<String>);
+
+/// Two to four ordinary outputs joined into one logical display.
+#[derive(knuffel::Decode, Debug, Clone, PartialEq)]
+pub struct DisplayGroup {
+    #[knuffel(children(name = "member"))]
+    pub members: Vec<DisplayGroupMember>,
+    #[knuffel(child, unwrap(argument, str), default)]
+    pub render_policy: GroupRenderPolicy,
+    #[knuffel(child, unwrap(argument, str), default)]
+    pub refresh_sync: GroupRefreshSync,
+    /// Stable selector of the member whose DRM sequence paces same-device groups.
+    #[knuffel(child, unwrap(argument))]
+    pub primary: Option<String>,
+}
+
+#[derive(knuffel::Decode, Debug, Clone, PartialEq)]
+pub struct DisplayGroupMember {
+    /// Connector name or the existing `make model serial` output selector.
+    #[knuffel(argument)]
+    pub output: String,
+    #[knuffel(child)]
+    pub mode: Option<Mode>,
+    #[knuffel(child, unwrap(argument, str), default = Transform::Normal)]
+    pub transform: Transform,
+    /// Position in post-transform physical pixels. Either every member supplies it or none do.
+    #[knuffel(child)]
+    pub position: Option<Position>,
+}
+
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub enum GroupRenderPolicy {
+    #[default]
+    Auto,
+    Composited,
+}
+
+impl FromStr for GroupRenderPolicy {
+    type Err = miette::Error;
+
+    fn from_str(value: &str) -> Result<Self, Self::Err> {
+        match value {
+            "auto" => Ok(Self::Auto),
+            "composited" => Ok(Self::Composited),
+            _ => Err(miette::miette!(
+                r#"invalid display-group render policy; expected "auto" or "composited""#
+            )),
+        }
+    }
+}
+
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub enum GroupRefreshSync {
+    #[default]
+    Strict,
+    Relaxed,
+}
+
+impl FromStr for GroupRefreshSync {
+    type Err = miette::Error;
+
+    fn from_str(value: &str) -> Result<Self, Self::Err> {
+        match value {
+            "strict" => Ok(Self::Strict),
+            "relaxed" => Ok(Self::Relaxed),
+            _ => Err(miette::miette!(
+                r#"invalid display-group refresh synchronization; expected "strict" or "relaxed""#
+            )),
+        }
+    }
+}
+
+/// Stable identity of the output declaration selected for a live output.
+///
+/// Output names are not required to be unique. For tiled outputs, the member declaration
+/// disambiguates otherwise-identically-named blocks across config reloads.
+#[derive(Debug, Clone, PartialEq)]
+pub struct OutputConfigBinding {
+    name: String,
+    tiled_group: Option<TiledGroup>,
+    display_group: Option<DisplayGroup>,
+}
+
+impl OutputConfigBinding {
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    pub fn equivalent(&self, other: &Self) -> bool {
+        self.name.eq_ignore_ascii_case(&other.name)
+            && tiled_groups_match(self.tiled_group.as_ref(), other.tiled_group.as_ref())
+            && display_groups_match(self.display_group.as_ref(), other.display_group.as_ref())
+    }
+
+    fn matches(&self, output: &Output) -> bool {
+        self.name.eq_ignore_ascii_case(&output.name)
+            && tiled_groups_match(self.tiled_group.as_ref(), output.tiled_group.as_ref())
+            && display_groups_match(self.display_group.as_ref(), output.display_group.as_ref())
+    }
+}
+
+impl From<&Output> for OutputConfigBinding {
+    fn from(output: &Output) -> Self {
+        Self {
+            name: output.name.clone(),
+            tiled_group: output.tiled_group.clone(),
+            display_group: output.display_group.clone(),
+        }
+    }
+}
+
+fn display_groups_match(a: Option<&DisplayGroup>, b: Option<&DisplayGroup>) -> bool {
+    match (a, b) {
+        (None, None) => true,
+        (Some(a), Some(b)) => {
+            a.render_policy == b.render_policy
+                && a.refresh_sync == b.refresh_sync
+                && match (&a.primary, &b.primary) {
+                    (None, None) => true,
+                    (Some(a), Some(b)) => a.eq_ignore_ascii_case(b),
+                    _ => false,
+                }
+                && a.members.len() == b.members.len()
+                && a.members.iter().zip(&b.members).all(|(a, b)| {
+                    a.output.eq_ignore_ascii_case(&b.output)
+                        && a.mode == b.mode
+                        && a.transform == b.transform
+                        && a.position == b.position
+                })
+        }
+        _ => false,
+    }
+}
+
+fn tiled_groups_match(a: Option<&TiledGroup>, b: Option<&TiledGroup>) -> bool {
+    match (a, b) {
+        (None, None) => true,
+        (Some(a), Some(b)) => {
+            a.0.len() == b.0.len() && a.0.iter().zip(&b.0).all(|(a, b)| a.eq_ignore_ascii_case(b))
+        }
+        _ => false,
+    }
+}
+
+impl<S: ErrorSpan> Decode<S> for TiledGroup {
+    fn decode_node(node: &SpannedNode<S>, ctx: &mut Context<S>) -> Result<Self, DecodeError<S>> {
+        let mut valid = true;
+        if let Some(type_name) = &node.type_name {
+            valid = false;
+            ctx.emit_error(DecodeError::unexpected(
+                type_name,
+                "type name",
+                "no type name expected for this node",
+            ));
+        }
+
+        for child in node.children() {
+            valid = false;
+            ctx.emit_error(DecodeError::unexpected(
+                child,
+                "node",
+                format!("unexpected node `{}`", child.node_name.escape_default()),
+            ));
+        }
+
+        for span in node.properties.keys() {
+            valid = false;
+            ctx.emit_error(DecodeError::unexpected(
+                span,
+                "property",
+                format!("unexpected property `{}`", span.escape_default()),
+            ));
+        }
+
+        let mut group_members = HashSet::new();
+        let mut members = Vec::new();
+        for (idx, arg) in node.arguments.iter().enumerate() {
+            let member: String = knuffel::traits::DecodeScalar::decode(arg, ctx)?;
+
+            if members.len() == 2 {
+                valid = false;
+                ctx.emit_error(DecodeError::unexpected(
+                    &arg.literal,
+                    "argument",
+                    "tiled-group accepts exactly two connectors",
+                ));
+                continue;
+            }
+
+            let normalized = member.to_ascii_lowercase();
+            if !group_members.insert(normalized.clone()) {
+                valid = false;
+                ctx.emit_error(DecodeError::unexpected(
+                    &arg.literal,
+                    "argument",
+                    format!("duplicate connector `{member}` in tiled-group"),
+                ));
+                continue;
+            }
+
+            members.push((member, normalized, idx));
+        }
+
+        if members.len() != 2 {
+            valid = false;
+            ctx.emit_error(DecodeError::missing(
+                node,
+                "tiled-group requires exactly two connectors",
+            ));
+        }
+
+        if !valid {
+            members.clear();
+        }
+
+        Ok(TiledGroup(
+            members.into_iter().map(|(member, _, _)| member).collect(),
+        ))
+    }
+}
+
+impl Output {
+    pub(crate) fn claim_group_members<S: ErrorSpan>(
+        &self,
+        claimed: &OutputGroupMemberSet,
+        node: &SpannedNode<S>,
+        ctx: &mut Context<S>,
+    ) -> bool {
+        if self.tiled_group.is_some() && self.display_group.is_some() {
+            ctx.emit_error(DecodeError::unexpected(
+                node,
+                "node",
+                "an output cannot contain both tiled-group and display-group",
+            ));
+            return false;
+        }
+
+        let (kind, members): (&str, Vec<(&str, S)>) = if let Some(group) = &self.tiled_group {
+            if group.0.len() != 2 {
+                return false;
+            }
+            let group_node = node
+                .children()
+                .find(|child| &**child.node_name == "tiled-group")
+                .unwrap_or(node);
+            (
+                "tiled-group",
+                group
+                    .0
+                    .iter()
+                    .zip(&group_node.arguments)
+                    .map(|(member, argument)| (member.as_str(), argument.literal.span().clone()))
+                    .collect(),
+            )
+        } else if let Some(group) = &self.display_group {
+            let group_node = node
+                .children()
+                .find(|child| &**child.node_name == "display-group")
+                .unwrap_or(node);
+            if self.transform != Transform::Normal
+                || self.mode.is_some()
+                || self.modeline.is_some()
+                || self.max_bpc.is_some()
+                || self.variable_refresh_rate.is_some()
+            {
+                ctx.emit_error(DecodeError::unexpected(
+                    group_node,
+                    "property",
+                    "display-group mode and transform belong on member blocks; modeline, max-bpc, and variable-refresh-rate are not supported",
+                ));
+                return false;
+            }
+            if !(2..=4).contains(&group.members.len()) {
+                ctx.emit_error(DecodeError::missing(
+                    group_node,
+                    "display-group requires between two and four members",
+                ));
+                return false;
+            }
+            let positioned = group
+                .members
+                .iter()
+                .filter(|member| member.position.is_some())
+                .count();
+            if positioned != 0 && positioned != group.members.len() {
+                ctx.emit_error(DecodeError::missing(
+                    group_node,
+                    "display-group positions must be supplied for every member or omitted for every member",
+                ));
+                return false;
+            }
+            let member_nodes = group_node
+                .children()
+                .filter(|child| &**child.node_name == "member")
+                .collect::<Vec<_>>();
+            for (member, member_node) in group.members.iter().zip(member_nodes) {
+                if member.mode.as_ref().is_some_and(|mode| mode.custom) {
+                    let mode_node = member_node
+                        .children()
+                        .find(|child| &**child.node_name == "mode")
+                        .unwrap_or(member_node);
+                    ctx.emit_error(DecodeError::unexpected(
+                        mode_node,
+                        "node",
+                        "custom display-group member modes are not supported; use an advertised mode",
+                    ));
+                    return false;
+                }
+                if member
+                    .position
+                    .is_some_and(|position| position.x < 0 || position.y < 0)
+                {
+                    let position_node = member_node
+                        .children()
+                        .find(|child| &**child.node_name == "position")
+                        .unwrap_or(member_node);
+                    ctx.emit_error(DecodeError::missing(
+                        position_node,
+                        "display-group member positions cannot be negative",
+                    ));
+                    return false;
+                }
+            }
+            if let Some(primary) = &group.primary {
+                let matches = group
+                    .members
+                    .iter()
+                    .filter(|member| member.output.eq_ignore_ascii_case(primary))
+                    .count();
+                if matches != 1 {
+                    ctx.emit_error(DecodeError::missing(
+                        group_node,
+                        "display-group primary must identify exactly one member",
+                    ));
+                    return false;
+                }
+            }
+            (
+                "display-group",
+                group
+                    .members
+                    .iter()
+                    .zip(
+                        group_node
+                            .children()
+                            .filter(|child| &**child.node_name == "member"),
+                    )
+                    .map(|(member, member_node)| {
+                        (member.output.as_str(), member_node.node_name.span().clone())
+                    })
+                    .collect(),
+            )
+        } else {
