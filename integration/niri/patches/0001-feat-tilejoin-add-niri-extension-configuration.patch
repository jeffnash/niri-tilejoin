+        let mut local = HashSet::new();
+        let mut valid = true;
+        for (member, span) in &members {
+            if !local.insert(member.to_ascii_lowercase()) {
+                valid = false;
+                ctx.emit_error(DecodeError::Unexpected {
+                    span: span.clone(),
+                    kind: "member",
+                    message: format!("duplicate output `{member}` in {kind}"),
+                });
+            }
+        }
+        let conflicts = {
+            let claimed = claimed.0.borrow();
+            members
+                .iter()
+                .filter(|(member, _)| claimed.contains(&member.to_ascii_lowercase()))
+                .cloned()
+                .collect::<Vec<_>>()
+        };
+        if !conflicts.is_empty() {
+            valid = false;
+            for (member, span) in conflicts {
+                let message = if kind == "tiled-group" {
+                    format!("connector `{member}` is already part of another tiled-group")
+                } else {
+                    format!("output `{member}` is already part of another output group")
+                };
+                ctx.emit_error(DecodeError::Unexpected {
+                    span,
+                    kind: "member",
+                    message,
+                });
+            }
+        }
+        if valid {
+            claimed.0.borrow_mut().extend(local);
+        }
+        valid
+    }
