+    pub fn find_bound(
+        &self,
+        name: &OutputName,
+        binding: Option<&OutputConfigBinding>,
+    ) -> Option<&Output> {
+        binding
+            .and_then(|binding| self.0.iter().find(|output| binding.matches(output)))
+            .or_else(|| self.find(name))
+    }
