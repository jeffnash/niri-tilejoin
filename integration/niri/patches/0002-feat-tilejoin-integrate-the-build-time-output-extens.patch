+/// Shared deadline for both tiles' completion events of one commit. Well inside any
+/// downstream watchdog; a frame that misses it is failed, never fabricated.
+const TILED_COMPLETION_TIMEOUT: Duration = Duration::from_millis(1500);
+
+/// Aggregates per-member vblank events of a tiled group; once both tiles delivered their
+/// event for the current frame, drives the logical output exactly like a single-CRTC vblank.
+fn on_tiled_vblank(
+    config: &Rc<RefCell<Config>>,
+    crtc_events: &mut HashMap<(DrmNode, crtc::Handle), CrtcEventTracker>,
+    device: &mut OutputDevice,
+    niri: &mut Niri,
+    node: DrmNode,
+    crtc: crtc::Handle,
+    meta: DrmEventMetadata,
+) {
+    let Some(primary) = device.tilejoin.primary_for_member(crtc) else {
+        return;
+    };
+    let Some(group) = device.tilejoin.live_group_mut(primary) else {
+        error!("tiled-groups: missing group in vblank callback for crtc {crtc:?}");
+        return;
+    };
+    let classification = crtc_events
+        .get(&(node, crtc))
+        .map(|tracker| tracker.classify(meta.sequence))
+        .unwrap_or(CrtcEventClassification::Reject);
+    let CrtcEventClassification::Retire {
+        submission,
+        current_generation,
+        ..
+    } = classification
+    else {
+        trace!(
+            ?node,
+            ?crtc,
+            sequence = meta.sequence,
+            "tiled-groups: rejecting untracked or pre-floor vblank"
+        );
+        return;
+    };
+    let Some(expected_submission) = group.pending_submission(crtc) else {
+        crtc_events
+            .get_mut(&(node, crtc))
+            .unwrap()
+            .retired(submission, meta.sequence);
+        trace!(
+            "tiled-groups: retired stale vblank for {} on crtc {crtc:?}",
+            group.name.connector,
+        );
+        return;
+    };
+    if submission != expected_submission || !current_generation {
+        crtc_events
+            .get_mut(&(node, crtc))
+            .unwrap()
+            .retired(submission, meta.sequence);
+        trace!(
+            ?node,
+            ?crtc,
+            "tiled-groups: retired stale event without completing current frame"
+        );
+        return;
+    }
+    crtc_events
+        .get_mut(&(node, crtc))
+        .unwrap()
+        .retired(submission, meta.sequence);
+    trace!(
+        "tiled-groups: {} member vblank on crtc {crtc:?}: sequence {}, time {:?}",
+        group.name.connector,
+        meta.sequence,
+        meta.time,
+    );
+
+    // Wait until both tiles delivered their event for this frame. The watchdog was armed
+    // when the frame was submitted, so it also covers the case where neither event arrives.
+    let Some((frame, meta)) = group.record_member_event(crtc, meta) else {
+        return;
+    };
+
+    let presentation = group.frame_presented(frame);
+    group.cancel_completion_watchdog(&niri.event_loop);
+
+    tiled_vblank_body(config, device, niri, node, primary, meta, presentation);
+}
+
+/// Tears down a tiled group whose frame did not complete on both members.
+fn tiled_completion_watchdog(state: &mut State, node: DrmNode, primary: crtc::Handle) {
+    let tty = state.backend.tty();
+    let Some(device) = tty.devices.get_mut(&node) else {
+        return;
+    };
+    let drm_active = device.drm.is_active();
+    let key = {
+        let Some(group) = device.tilejoin.live_group_mut(primary) else {
+            return;
+        };
+        group.completion_watchdog = None;
+
+        // Session pause can race with an already-dispatched timer. Resume reconciliation resets
+        // the frame safely once DRM access is active again.
+        if !drm_active {
+            return;
+        }
+
+        if !group.has_pending_frame() {
+            return;
+        }
+
+        group.name.connector.clone()
+    };
+
+    // We cannot safely reuse either the previous or pending framebuffer when only one CRTC
+    // may have completed. Disable both heads together and retry with bounded backoff.
+    let policy = record_tiled_failure(
+        device.tilejoin.formation_failures_mut(),
+        TiledFailureScope::Formation,
+        drm_active,
+        &state.niri.event_loop,
+        node,
+        key.clone(),
+        TiledFailureClass::Retryable,
+    );
+    error!(
+        "tiled-groups: flip completion timed out on {key}; falling back to separate outputs; \
+         failure policy: {policy:?}"
+    );
+    tiled_group_teardown(device, &mut tty.crtc_events, &mut state.niri, node, primary);
+    tty.reconcile_output_config(&mut state.niri, Some(node));
+}
