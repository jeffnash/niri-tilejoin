+/// The shared tail of tiled vblank handling, run once per aggregated event.
+fn tiled_vblank_body(
+    config: &Rc<RefCell<Config>>,
+    device: &mut OutputDevice,
+    niri: &mut Niri,
+    node: DrmNode,
+    primary: crtc::Handle,
+    meta: DrmEventMetadata,
+    presentation: TiledPresentation,
+) {
+    let span = tracy_client::span!("Tty::tiled_vblank_body");
+
+    let now = get_monotonic_time();
+
+    let Some(group) = device.tilejoin.live_group_mut(primary) else {
+        return;
+    };
+
+    // Finish the Tracy frame, if any.
+    drop(group.vblank_frame.take());
+
+    let name = group.name.connector.clone();
+    trace!("vblank on {name} {meta:?}");
+    span.emit_text(&name);
+
+    let presentation_time = match meta.time {
+        DrmEventTime::Monotonic(time) => time,
+        DrmEventTime::Realtime(_) => {
+            // Not supported.
+
+            // This value will be ignored in the frame clock code.
+            Duration::ZERO
+        }
+    };
+    let presentation_time = if config.borrow().debug.emulate_zero_presentation_time {
+        Duration::ZERO
+    } else {
+        presentation_time
+    };
+
+    let message = if presentation_time.is_zero() {
+        format!("vblank on {name}, presentation time unknown")
+    } else if presentation_time > now {
+        let diff = presentation_time - now;
+        tracy_client::Client::running().unwrap().plot(
+            group.time_since_presentation_plot_name,
+            -diff.as_secs_f64() * 1000.,
+        );
+        format!("vblank on {name}, presentation is {diff:?} later")
+    } else {
+        let diff = now - presentation_time;
+        tracy_client::Client::running().unwrap().plot(
+            group.time_since_presentation_plot_name,
+            diff.as_secs_f64() * 1000.,
+        );
+        format!("vblank on {name}, presentation was {diff:?} ago")
+    };
+    tracy_client::Client::running()
+        .unwrap()
+        .message(&message, 0);
+
+    let Some(output) = tiled_output(niri, node, primary) else {
+        error!("missing output in global space for {name}");
+        return;
+    };
+
+    let Some(output_state) = niri.output_state.get_mut(&output) else {
+        error!("missing output state for {name}");
+        return;
+    };
+
+    let refresh_interval = output_state.frame_clock.refresh_interval();
+
+    let time = if presentation_time.is_zero() {
+        now
+    } else {
+        presentation_time
+    };
+
+    let Some(presentation) = output_state.vblank_throttle.throttle_with(
+        refresh_interval,
+        time,
+        presentation,
+        move |state, presentation| {
+            let meta = DrmEventMetadata {
+                sequence: meta.sequence,
+                time: DrmEventTime::Monotonic(Duration::ZERO),
+            };
+
+            let tty = state.backend.tty();
+            let Some(device) = tty.devices.get_mut(&node) else {
+                return;
+            };
+            tiled_vblank_body(
+                &tty.config,
+                device,
+                &mut state.niri,
+                node,
+                primary,
+                meta,
+                presentation,
+            );
+        },
+    ) else {
+        // Throttled.
+        return;
+    };
+
+    let redraw_needed = match mem::replace(&mut output_state.redraw_state, RedrawState::Idle) {
+        RedrawState::WaitingForVBlank { redraw_needed } => redraw_needed,
+        state @ (RedrawState::Idle
+        | RedrawState::Queued
+        | RedrawState::WaitingForEstimatedVBlank(_)
+        | RedrawState::WaitingForEstimatedVBlankAndQueued(_)) => {
+            // See the corresponding note in on_vblank().
+            error!(
+                "unexpected redraw state for output {name} (should be WaitingForVBlank); \
+                 can happen when resuming from sleep or powering on monitors: {state:?}"
+            );
+            true
+        }
+    };
+
+    // Mark the last frame as presented on both tiles.
+    let TiledPresentation {
+        mut feedback,
+        target_presentation_time,
+    } = presentation;
+    let refresh = match refresh_interval {
+        Some(refresh) => {
+            if output_state.frame_clock.vrr() {
+                Refresh::Variable(refresh)
+            } else {
+                Refresh::Fixed(refresh)
+            }
+        }
+        None => Refresh::Unknown,
+    };
+
+    // FIXME: ideally should be monotonically increasing for a surface.
+    let seq = meta.sequence as u64;
+    let mut flags =
+        wp_presentation_feedback::Kind::Vsync | wp_presentation_feedback::Kind::HwCompletion;
+
+    if !presentation_time.is_zero() {
+        flags.insert(wp_presentation_feedback::Kind::HwClock);
+    }
+
+    feedback.presented::<_, smithay::utils::Monotonic>(time, refresh, seq, flags);
+
+    if !presentation_time.is_zero() {
+        let misprediction_s =
+            presentation_time.as_secs_f64() - target_presentation_time.as_secs_f64();
+        tracy_client::Client::running().unwrap().plot(
+            group.presentation_misprediction_plot_name,
+            misprediction_s * 1000.,
+        );
+    }
+
+    if let Some(last_sequence) = output_state.last_drm_sequence {
+        let delta = meta.sequence as f64 - last_sequence as f64;
+        tracy_client::Client::running()
+            .unwrap()
+            .plot(group.sequence_delta_plot_name, delta);
+    }
+    output_state.last_drm_sequence = Some(meta.sequence);
+
+    output_state.frame_clock.presented(presentation_time);
+
+    if redraw_needed || output_state.unfinished_animations_remain {
+        let vblank_frame = tracy_client::Client::running()
+            .unwrap()
+            .non_continuous_frame(group.vblank_frame_name);
+        group.vblank_frame = Some(vblank_frame);
+
+        niri.queue_redraw(&output);
+    } else {
+        niri.send_frame_callbacks(&output);
+    }
+}
+
+fn arm_tiled_completion_watchdog(
+    event_loop: &LoopHandle<'static, State>,
+    group: &mut TiledGroup,
+    node: DrmNode,
+    primary: crtc::Handle,
+) {
+    if !group.has_pending_frame() || group.completion_watchdog.is_some() {
+        return;
+    }
+
+    let token = event_loop
+        .insert_source(
+            Timer::from_duration(TILED_COMPLETION_TIMEOUT),
+            move |_, _, state| {
+                tiled_completion_watchdog(state, node, primary);
+                TimeoutAction::Drop
+            },
+        )
+        .unwrap();
+    group.completion_watchdog = Some(token);
+}
+
+#[allow(clippy::too_many_arguments)]
+fn finish_tiled_submission(
+    niri: &mut Niri,
+    output: &Output,
+    group: &mut TiledGroup,
+    node: DrmNode,
+    primary: crtc::Handle,
+    buffer: TiledScanoutBuffer,
+    feedback: OutputPresentationFeedback,
+    target_presentation_time: Duration,
+    crtc_events: &mut HashMap<(DrmNode, crtc::Handle), CrtcEventTracker>,
+) -> RenderResult {
+    let submissions = std::array::from_fn(|member| {
+        let crtc = group.members[member].crtc;
+        crtc_events.entry((node, crtc)).or_default().enqueue()
+    });
+    let frame = PendingTiledFrame {
+        buffer,
+        feedback,
+        target_presentation_time,
+        submissions,
+    };
+    group.frame_committed(frame);
+    arm_tiled_completion_watchdog(&niri.event_loop, group, node, primary);
+
+    let output_state = niri.output_state.get_mut(output).unwrap();
+    let new_state = RedrawState::WaitingForVBlank {
+        redraw_needed: false,
+    };
+    match mem::replace(&mut output_state.redraw_state, new_state) {
+        RedrawState::Idle => unreachable!(),
+        RedrawState::Queued => (),
+        RedrawState::WaitingForVBlank { .. } => unreachable!(),
+        RedrawState::WaitingForEstimatedVBlank(_) => unreachable!(),
+        RedrawState::WaitingForEstimatedVBlankAndQueued(token) => {
+            niri.event_loop.remove(token);
+        }
+    };
+
+    // The submitted frame latched every current client buffer. New commits can no longer
+    // overwrite it and will wait for the aggregated tiled vblank.
+    output_state.frame_callback_sequence = output_state.frame_callback_sequence.wrapping_add(1);
+    RenderResult::Submitted
+}
+
+/// Renders one framebuffer for a tiled group and commits it cropped across both tiles in a
+/// single atomic request.
+#[allow(clippy::too_many_arguments)]
+fn render_tiled(
+    config: &Rc<RefCell<Config>>,
+    gpu_manager: &mut GpuManager<GbmGlesBackend<GlesRenderer, DrmDeviceFd>>,
+    primary_render_node: DrmNode,
+    device: &mut OutputDevice,
+    niri: &mut Niri,
+    output: &Output,
+    node: DrmNode,
+    primary: crtc::Handle,
+    target_presentation_time: Duration,
+    crtc_events: &mut HashMap<(DrmNode, crtc::Handle), CrtcEventTracker>,
+) -> RenderResult {
+    let span = tracy_client::span!("Tty::render_tiled");
+
+    let mut rv = RenderResult::Skipped;
+
+    let generation = device.tilejoin.generation();
+    let Some((group, formation_failures)) = device
+        .tilejoin
+        .live_group_and_formation_failures_mut(primary)
+    else {
+        error!("missing tiled group");
+        return rv;
+    };
+
+    span.emit_text(&group.name.connector);
+
+    if !device.drm.is_active() {
+        // This branch hits any time we try to render while the user had switched to a
+        // different VT, so don't print anything here.
+        return rv;
+    }
+
+    // Cannot commit a new frame while the previous one has not been presented on both tiles;
+    // its framebuffer may still be scanned out. The kernel delivers both events for a
+    // committed frame, so this only triggers when something is already wrong.
+    if group.has_pending_frame() {
+        warn!(
+            "tiled-groups: skipping render on {}, a frame is still awaiting presentation",
+            group.name.connector,
+        );
+        return rv;
+    }
+
+    let mut renderer = match gpu_manager.renderer(
+        &primary_render_node,
+        &device.render_node.unwrap_or(primary_render_node),
+        group.format(),
+    ) {
+        Ok(renderer) => renderer,
+        Err(err) => {
+            warn!("error creating renderer for primary GPU: {err:?}");
+            return rv;
+        }
+    };
+
+    // Render the elements.
+    let ctx = RenderCtx {
+        renderer: &mut renderer,
+        target: RenderTarget::Output,
+        xray: None,
+    };
+    let mut elements = niri.render_to_vec(ctx, output, true);
+
+    if let Some(metadata) = output.user_data().get::<TiledDmabufFeedback>() {
+        let eligibility = if config.borrow().debug.disable_direct_scanout {
+            Err(TiledDirectScanoutRejection::Disabled)
+        } else if niri.debug_draw_damage {
+            Err(TiledDirectScanoutRejection::OverlayOrCursor)
+        } else if !group.direct_scanout_active(generation) {
+            Err(TiledDirectScanoutRejection::NeedsModeset)
+        } else {
+            tiled_direct_scanout_candidate(&mut renderer, output, &elements, metadata)
+        };
+
+        match eligibility {
+            Ok(candidate) => {
+                let direct_fb = match group.direct_framebuffer(&device.drm, &candidate.buffer) {
+                    Ok(Some(framebuffer)) => Some(framebuffer),
+                    Ok(None) => {
+                        trace!(
+                            "tiled-groups: {} direct-scanout rejected: {:?}",
+                            group.name.connector,
+                            TiledDirectScanoutRejection::FramebufferExport,
+                        );
+                        None
+                    }
+                    Err(err) => {
+                        trace!(
+                            "tiled-groups: {} direct-scanout rejected: {:?}: {err:?}",
+                            group.name.connector,
+                            TiledDirectScanoutRejection::FramebufferExport,
+                        );
+                        None
+                    }
+                };
+
+                if let Some(framebuffer) = direct_fb {
+                    let fb = *framebuffer.as_ref();
+                    let test_req = group.build_flip_request(fb);
+                    if let Err(err) = device
+                        .drm
+                        .atomic_commit(AtomicCommitFlags::TEST_ONLY, test_req)
+                    {
+                        trace!(
+                            "tiled-groups: {} direct-scanout rejected: {:?}: {err:?}",
+                            group.name.connector,
+                            TiledDirectScanoutRejection::TestOnly,
+                        );
+                    } else {
+                        let req = group.build_flip_request(fb);
+                        let flags =
+                            AtomicCommitFlags::NONBLOCK | AtomicCommitFlags::PAGE_FLIP_EVENT;
+                        match device.drm.atomic_commit(flags, req) {
+                            Ok(()) => {
+                                let mode = output.current_mode().unwrap();
+                                let visible_area =
+                                    (mode.size.w as usize).saturating_mul(mode.size.h as usize);
+                                let states = tiled_direct_scanout_states(
+                                    elements.iter().map(|element| element.id().clone()),
+                                    &candidate.element_id,
+                                    visible_area,
+                                );
+                                niri.update_primary_scanout_output(output, &states);
+                                niri.send_dmabuf_feedbacks(output, &metadata.feedback, &states);
+                                let feedback = niri.take_presentation_feedbacks(output, &states);
+                                trace!(
+                                    "tiled-groups: {} direct scanout submitted: element {:?}, \
+                                     format {:?}",
+                                    group.name.connector,
+                                    candidate.element_id,
+                                    candidate.dmabuf.format(),
+                                );
+                                return finish_tiled_submission(
+                                    niri,
+                                    output,
+                                    group,
+                                    node,
+                                    primary,
+                                    TiledScanoutBuffer::Direct {
+                                        buffer: candidate.buffer,
+                                        framebuffer,
+                                    },
+                                    feedback,
+                                    target_presentation_time,
+                                    crtc_events,
+                                );
+                            }
+                            Err(err) => trace!(
+                                "tiled-groups: {} direct-scanout rejected: {:?}: {err:?}",
+                                group.name.connector,
+                                TiledDirectScanoutRejection::Commit,
+                            ),
+                        }
+                    }
+                }
+            }
+            Err(reason) => trace!(
+                "tiled-groups: {} direct-scanout rejected: {reason:?}",
+                group.name.connector,
+            ),
+        }
+    }
+
+    group.prepare_composited_frame();
+
+    // Visualize the damage, if enabled.
+    if niri.debug_draw_damage {
+        let output_state = niri.output_state.get_mut(output).unwrap();
+        draw_damage(&mut output_state.debug_damage_tracker, &mut elements);
+    }
+
+    let mut rendered_slot = false;
+
+    macro_rules! fail {
+        () => {{
+            if rendered_slot {
+                // This slot was modified without becoming the next scanout buffer. Buffer ages
+                // no longer describe its contents, so force conservative full damage.
+                group.reset_buffer_ages();
+            }
+
+            // We're not expecting a vblank right after this.
+            drop(group.vblank_frame.take());
+
+            // Queue a timer to fire at the predicted vblank time.
+            queue_estimated_vblank_timer(niri, output.clone(), target_presentation_time);
+            return rv;
+        }};
+    }
+
+    macro_rules! suppress_group {
+        ($context:expr, $err:expr, $class:expr) => {{
+            let key = group.name.connector.clone();
+            let policy = record_tiled_failure(
+                formation_failures,
+                TiledFailureScope::Formation,
+                device.drm.is_active(),
+                &niri.event_loop,
+                node,
+                key,
+                $class,
+            );
+            warn!(
+                "tiled-groups: {} for {}: {:?}; falling back to separate outputs; \
+                 failure policy: {policy:?}",
+                $context, group.name.connector, $err
+            );
+            // The caller still holds the output state, so teardown must run from idle.
+            niri.event_loop.insert_idle(move |state| {
+                let tty = state.backend.tty();
+                if let Some(device) = tty.devices.get_mut(&node) {
+                    if device.tilejoin.owns_crtc(primary) {
+                        tiled_group_teardown(
+                            device,
+                            &mut tty.crtc_events,
+                            &mut state.niri,
+                            node,
+                            primary,
+                        );
+                    }
+                }
+                state
+                    .backend
+                    .tty()
+                    .reconcile_output_config(&mut state.niri, Some(node));
+            });
+            fail!();
+        }};
+    }
+
+    let slot = match group.acquire() {
+        Ok(Some(slot)) => slot,
+        Ok(None) => {
+            warn!("tiled-groups: no free swapchain slot");
+            fail!();
+        }
+        Err(err) => {
+            warn!("tiled-groups: error acquiring swapchain slot: {err:?}");
+            fail!();
+        }
+    };
+
+    let mut commit_state = group.prepare_commit(generation, &slot);
+    let buffer_age = if commit_state == TiledCommitState::NeedsValidation {
+        0
+    } else {
+        slot.age()
+    };
+    let wl_mode = group.wl_mode();
+    let total_pixels = u64::from(wl_mode.size.w as u32) * u64::from(wl_mode.size.h as u32);
+    let res = {
+        let mut dmabuf = match group.slot_dmabuf(&slot) {
+            Ok(dmabuf) => dmabuf,
+            Err(err) => {
+                warn!("tiled-groups: error exporting dmabuf: {err:?}");
+                fail!();
+            }
+        };
+        let mut framebuffer = match renderer.bind(&mut dmabuf) {
+            Ok(framebuffer) => framebuffer,
+            Err(err) => {
+                warn!("tiled-groups: error binding framebuffer: {err:?}");
+                fail!();
+            }
+        };
+        match group.damage_tracker.render_output(
+            &mut renderer,
+            &mut framebuffer,
+            usize::from(buffer_age),
+            &elements,
+            [0.; 4],
+        ) {
+            Ok(res) => {
+                rendered_slot = res.damage.is_some();
+                res
+            }
+            Err(err) => {
+                // Rendering may have partially modified the slot.
+                rendered_slot = true;
+                // Can fail if we switched to a different TTY.
+                warn!("tiled-groups: error rendering frame: {err:?}");
+                fail!();
+            }
+        }
+    };
+
+    niri.update_primary_scanout_output(output, &res.states);
+    if let Some(metadata) = output.user_data().get::<TiledDmabufFeedback>() {
+        niri.send_dmabuf_feedbacks(output, &metadata.feedback, &res.states);
+    }
+
+    if res.damage.is_none() {
+        rv = RenderResult::NoDamage;
+        drop(res);
+        fail!();
+    }
+
+    let damaged_pixels = res.damage.map_or(0, |damage| {
+        damage
+            .iter()
+            .map(|rect| u64::from(rect.size.w as u32) * u64::from(rect.size.h as u32))
+            .sum::<u64>()
+    });
+    // Unlike Smithay's single-CRTC compositor, the tiled KMS builder does not attach
+    // IN_FENCE_FD properties. Waiting is therefore mandatory before either CRTC can reference
+    // this freshly rendered buffer. Interrupted waits do not imply completion, so retry them.
+    let _span = tracy_client::span!("wait for tiled render completion");
+    while let Err(err) = res.sync.wait() {
+        warn!("tiled render completion wait was interrupted; retrying: {err:?}");
+    }
+
+    // Last use of res; the damage tracker borrow ends here.
+    let presentation_feedbacks = niri.take_presentation_feedbacks(output, &res.states);
+    trace!(
+        "tiled-groups: {} buffer age {buffer_age}, damage {damaged_pixels}/{total_pixels} pixels",
+        group.name.connector
+    );
+
+    let fb = match group.slot_framebuffer(&device.drm, &slot) {
+        Ok(fb) => fb,
+        Err(err) => {
+            warn!("tiled-groups: error exporting framebuffer: {err:?}");
+            fail!();
+        }
+    };
+
+    if commit_state == TiledCommitState::NeedsValidation {
+        // Validate the whole group with one TEST_ONLY commit first; never leave the tiles
+        // half-programmed. A validation performed while connecting is reused only while its
+        // exact topology, KMS properties, mode, format, and modifier fingerprint still match.
+        let test_req = match group.build_validation_request(&device.drm, fb) {
+            Ok(req) => req,
+            Err(err) => {
+                suppress_group!(
+                    "error building validation commit",
+                    err,
+                    TiledFailureClass::Retryable
+                );
+            }
+        };
+        if let Err(err) = device.drm.atomic_commit(
+            AtomicCommitFlags::TEST_ONLY | AtomicCommitFlags::ALLOW_MODESET,
+            test_req,
+        ) {
+            let class = classify_tiled_test_only_failure(&err);
+            suppress_group!("TEST_ONLY commit failed", err, class);
+        }
+        group.validation_succeeded(generation, &slot);
+        commit_state = TiledCommitState::ValidatedNeedsModeset;
+    }
+
+    let (req, modeset, property_count) = match commit_state {
+        TiledCommitState::NeedsValidation => unreachable!("validation must precede submission"),
+        TiledCommitState::ValidatedNeedsModeset => {
+            let req = match group.build_modeset_request(&device.drm, fb) {
+                Ok(req) => req,
+                Err(err) => suppress_group!(
+                    "error building modeset commit",
+                    err,
+                    TiledFailureClass::Retryable
+                ),
+            };
+            (req, true, group.modeset_property_count())
+        }
+        TiledCommitState::Active => (group.build_flip_request(fb), false, 2),
+    };
+
+    trace!(
+        "tiled-groups: {} submitting {} atomic commit with {property_count} properties",
+        group.name.connector,
+        if modeset { "modeset" } else { "flip" }
+    );
+
+    let mut flags = AtomicCommitFlags::NONBLOCK | AtomicCommitFlags::PAGE_FLIP_EVENT;
+    if modeset {
+        flags |= AtomicCommitFlags::ALLOW_MODESET;
+    }
+
+    match device.drm.atomic_commit(flags, req) {
+        Ok(()) => {
+            if modeset {
+                group.modeset_succeeded();
+            }
+            group.frame_submitted(&slot);
+            finish_tiled_submission(
+                niri,
+                output,
+                group,
+                node,
+                primary,
+                TiledScanoutBuffer::Composited(slot),
+                presentation_feedbacks,
+                target_presentation_time,
+                crtc_events,
+            )
+        }
+        Err(err) => {
+            suppress_group!("error committing frame", err, TiledFailureClass::Retryable);
+        }
+    }
+}
