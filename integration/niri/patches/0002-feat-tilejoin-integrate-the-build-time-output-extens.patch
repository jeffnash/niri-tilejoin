+    #[test]
+    fn tiled_scanout_format_prefers_xrgb_and_requires_a_common_modifier() {
+        let render = format_set(&[
+            (Fourcc::Argb8888, Modifier::Linear),
+            (Fourcc::Xrgb8888, Modifier::Invalid),
+            (Fourcc::Xrgb8888, Modifier::Linear),
+        ]);
+        let left = format_set(&[
+            (Fourcc::Xrgb8888, Modifier::Invalid),
+            (Fourcc::Xrgb8888, Modifier::Linear),
+            (Fourcc::Argb8888, Modifier::Linear),
+        ]);
+        let right = format_set(&[
+            (Fourcc::Xrgb8888, Modifier::Linear),
+            (Fourcc::Argb8888, Modifier::Linear),
+        ]);
+
+        let chosen = choose_tiled_scanout_format(&render, &[&left, &right]).unwrap();
+        assert_eq!(chosen, (Fourcc::Xrgb8888, vec![Modifier::Linear]));
+        let common = tiled_scanout_formats(&render, &[&left, &right]);
+        assert_eq!(common.iter().count(), 2);
+        assert!(common.contains(&Format {
+            code: Fourcc::Xrgb8888,
+            modifier: Modifier::Linear,
+        }));
+        assert!(common.contains(&Format {
+            code: Fourcc::Argb8888,
+            modifier: Modifier::Linear,
+        }));
+
+        let argb_only = format_set(&[(Fourcc::Argb8888, Modifier::Linear)]);
+        let chosen = choose_tiled_scanout_format(&render, &[&left, &argb_only]).unwrap();
+        assert_eq!(chosen, (Fourcc::Argb8888, vec![Modifier::Linear]));
+
+        let incompatible = format_set(&[(Fourcc::Xrgb8888, Modifier::Invalid)]);
+        assert!(choose_tiled_scanout_format(&render, &[&right, &incompatible]).is_none());
+    }
