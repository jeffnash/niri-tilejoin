+    #[test]
+    fn render_format_filter_excludes_ccs_and_limits_display_only_devices() {
+        let ccs = [
+            Modifier::I915_y_tiled_ccs,
+            Modifier::Unrecognized(0x100000000000005),
+            Modifier::I915_y_tiled_gen12_rc_ccs,
+            Modifier::I915_y_tiled_gen12_mc_ccs,
+            Modifier::Unrecognized(0x100000000000008),
+            Modifier::Unrecognized(0x10000000000000a),
+            Modifier::Unrecognized(0x10000000000000b),
+            Modifier::Unrecognized(0x10000000000000c),
+        ];
+        assert!(ccs.into_iter().all(is_ccs_modifier));
+
+        let mut formats = ccs
+            .into_iter()
+            .map(|modifier| (Fourcc::Xrgb8888, modifier))
+            .collect::<Vec<_>>();
+        formats.extend([
+            (Fourcc::Xrgb8888, Modifier::Linear),
+            (Fourcc::Xrgb8888, Modifier::Invalid),
+        ]);
+        let formats = format_set(&formats);
+
+        let filtered = filter_render_formats(&formats, false);
+        assert_eq!(filtered.iter().count(), 2);
+        assert!(filtered
+            .iter()
+            .all(|format| !is_ccs_modifier(format.modifier)));
+
+        let display_only = filter_render_formats(&formats, true);
+        assert_eq!(display_only.iter().count(), 1);
+        assert_eq!(
+            display_only.iter().next().unwrap().modifier,
+            Modifier::Linear
+        );
+    }
