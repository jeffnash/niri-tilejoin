+impl super::tty::Tty {
+    pub(super) fn display_group_connected(
+        &mut self,
+        niri: &mut Niri,
+        plan: OutputGroupPlan,
+    ) -> anyhow::Result<()> {
+        ensure!(
+            !self.display_groups.groups.contains_key(&plan.key)
+                && !self.display_groups.quarantined.contains_key(&plan.key),
+            "display group is already connected"
+        );
+
+        // Build one ordinary Smithay DRM compositor per member without publishing transient
+        // member wl_outputs. Existing standalone fallbacks are absorbed in place.
+        let mut journal = FormationJournal::default();
+        let preparation = (|| -> anyhow::Result<Vec<Output>> {
+            let mut hidden_outputs = Vec::with_capacity(plan.members.len());
+            for member in &plan.members {
+                let exists = self
+                    .devices
+                    .get(&member.node)
+                    .is_some_and(|device| device.surfaces.contains_key(&member.crtc));
+                let member_output = if exists {
+                    let hidden = self
+                        .devices
+                        .get(&member.node)
+                        .and_then(|device| device.surfaces.get(&member.crtc))
+                        .and_then(|surface| surface.kms_output.clone());
+                    let public = niri
+                        .global_space
+                        .outputs()
+                        .find(|output| {
+                            let state: &TtyOutputState = output.user_data().get().unwrap();
+                            state.node == member.node && state.crtc == member.crtc
+                        })
+                        .cloned();
+                    hidden
+                        .or(public)
+                        .context("missing output object for existing display-group member")?
+                } else {
+                    let output = self
+                        .connector_surface_connected(
+                            niri,
+                            member.node,
+                            member.connector.clone(),
+                            member.crtc,
+                            Some(member.mode),
+                            false,
+                        )?
+                        .context("display-group member did not create an output object")?;
+                    journal.record_created((member.node, member.crtc));
+                    output
+                };
+                let device = self
+                    .devices
+                    .get_mut(&member.node)
+                    .context("display-group member device disappeared")?;
+                let surface = device
+                    .surfaces
+                    .get_mut(&member.crtc)
+                    .context("display-group member surface was not created")?;
+                if exists {
+                    journal.record_changed((
+                        member.node,
+                        member.crtc,
+                        surface.compositor.pending_mode(),
+                        surface.kms_output.clone(),
+                    ));
+                }
+                surface
+                    .compositor
+                    .use_mode(member.mode)
+                    .context("error selecting display-group member mode")?;
+                surface.kms_output = Some(member_output.clone());
+                hidden_outputs.push(member_output);
+            }
+            Ok(hidden_outputs)
+        })();
+        let hidden_outputs = match preparation {
+            Ok(outputs) => outputs,
+            Err(err) => {
+                // No public member output is withdrawn until every member has prepared. Remove
+                // only surfaces created by this attempt; pre-existing standalone outputs remain
+                // exactly as they were.
+                let (previous_surfaces, created_members) = journal.rollback();
+                for (node, crtc, mode, kms_output) in previous_surfaces {
+                    if let Some(surface) = self
+                        .devices
+                        .get_mut(&node)
+                        .and_then(|device| device.surfaces.get_mut(&crtc))
+                    {
+                        if let Err(restore_err) = surface.compositor.use_mode(mode) {
+                            warn!("display-group formation rollback could not restore member mode: {restore_err:?}");
+                        }
+                        surface.kms_output = kms_output;
+                    }
+                }
+                for (node, crtc) in created_members {
+                    if let Some(device) = self.devices.get_mut(&node) {
+                        if let Some(mut surface) = device.surfaces.remove(&crtc) {
+                            if let Some(gamma_props) = &mut surface.gamma_props {
+                                gamma_props.destroy(&device.drm);
+                            }
+                        }
+                    }
+                }
+                return Err(err);
+            }
+        };
+        journal.commit();
+
+        // Formation is now committed: withdraw every former standalone output as one logical
+        // operation. The remaining publication steps are infallible bookkeeping.
+        for member in &plan.members {
+            self.crtc_events
+                .entry((member.node, member.crtc))
+                .or_default()
+                .begin_generation();
+        }
+        for member_output in &hidden_outputs {
+            if niri.output_state.contains_key(member_output) {
+                niri.remove_output(member_output);
+            }
+        }
+
+        let primary = &plan.members[plan.primary];
+        let physical_size = display_group_physical_size(&plan)
+            .map(|(width, height)| (width as i32, height as i32))
+            .unwrap_or((0, 0));
+        let output = Output::new(
+            plan.name.connector.clone(),
+            PhysicalProperties {
+                size: physical_size.into(),
+                subpixel: primary.connector.subpixel().into(),
+                model: plan.name.model.as_deref().unwrap_or("Unknown").to_owned(),
+                make: plan.name.make.as_deref().unwrap_or("Unknown").to_owned(),
+                serial_number: plan.name.serial.as_deref().unwrap_or("Unknown").to_owned(),
+            },
+        );
+        let wl_mode = Mode {
+            size: (plan.size.width as i32, plan.size.height as i32).into(),
+            refresh: plan.pacing_refresh.millihz as i32,
+        };
+        output.change_current_state(Some(wl_mode), None, None, None);
+        output.set_preferred(wl_mode);
+        output.user_data().insert_if_missing(|| TtyOutputState {
+            node: primary.node,
+            crtc: primary.crtc,
+        });
+        output.user_data().insert_if_missing(|| plan.name.clone());
+        if let Some(binding) = &plan.config {
+            output.user_data().insert_if_missing(|| binding.clone());
+        }
+
+        let refresh_interval = pacing_refresh_interval(&[plan.pacing_refresh]);
+        niri.add_output(output.clone(), refresh_interval, false);
+        let scale = output.current_scale();
+        for (member, hidden) in plan.members.iter().zip(hidden_outputs) {
+            let member_mode = Mode::from(member.mode);
+            hidden.change_current_state(
+                Some(member_mode),
+                Some(ipc_transform_to_smithay(member.transform)),
+                Some(scale),
+                None,
+            );
+            hidden.set_preferred(member_mode);
+            // A mode/transform transition must invalidate member-local damage history.
+            self.devices
+                .get_mut(&member.node)
+                .unwrap()
+                .surfaces
+                .get_mut(&member.crtc)
+                .unwrap()
+                .compositor
+                .reset_buffers();
+        }
+
+        let dmabuf_feedback = match self.display_group_dmabuf_feedback(&plan) {
+            Ok(feedback) => Some(feedback),
+            Err(err) => {
+                warn!(
+                    group = plan.name.connector,
+                    "error building display-group dma-buf feedback: {err:?}"
+                );
+                None
+            }
+        };
+        let id = self.display_groups.output_id(&plan.key);
+        let generation = self.display_groups.next_generation();
+        self.display_groups.insert(LiveDisplayGroup {
+            generation,
+            event_key: Arc::from(plan.key.as_str()),
+            plan: Arc::new(plan),
+            id,
+            dmabuf_feedback,
+            frames: LogicalFrameLifecycle::default(),
+            member_scanout: [None; MAX_GROUP_MEMBERS],
+            force_composite_next: false,
+            completion_watchdog: None,
+            pending_gamma_change: None,
+            gamma_recovery: None,
+        });
+
+        if niri.monitors_active {
+            niri.event_loop.insert_idle(move |state| {
+                if state.niri.output_state.contains_key(&output) {
+                    state.niri.queue_redraw(&output);
+                }
+            });
+        }
+        Ok(())
+    }
+
+    fn display_group_dmabuf_feedback(
+        &mut self,
+        plan: &OutputGroupPlan,
+    ) -> anyhow::Result<SurfaceDmabufFeedback> {
+        let renderer = self
+            .gpu_manager
+            .single_renderer(&self.primary_render_node)
+            .context("missing primary renderer")?;
+        let primary_formats = renderer.dmabuf_formats();
+        let mut common_scanout_formats = primary_formats.clone();
+        let mut scanout_nodes = Vec::new();
+        let mut requires_linear = false;
+
+        for member in &plan.members {
+            let device = self
+                .devices
+                .get(&member.node)
+                .context("missing display-group member device")?;
+            let surface = device
+                .surfaces
+                .get(&member.crtc)
+                .context("missing display-group member surface")?;
+            common_scanout_formats = common_scanout_formats
+                .intersection(&surface.compositor.surface().plane_info().formats)
+                .copied()
+                .collect();
+            requires_linear |= device.render_node != Some(self.primary_render_node);
+            if !scanout_nodes.contains(&member.node) {
+                scanout_nodes.push(member.node);
+            }
+        }
+        if requires_linear {
+            common_scanout_formats = common_scanout_formats
+                .iter()
+                .copied()
+                .filter(|format| format.modifier == Modifier::Linear)
+                .collect();
+        }
+
+        let builder =
+            DmabufFeedbackBuilder::new(self.primary_render_node.dev_id(), primary_formats);
+        let render = builder.clone().build()?;
+        let formats = common_scanout_formats.iter().copied().collect::<Vec<_>>();
+        let mut scanout_builder = builder;
+        for node in scanout_nodes {
+            scanout_builder = scanout_builder.add_preference_tranche(
+                node.dev_id(),
+                Some(TrancheFlags::Scanout),
+                formats.clone(),
+            );
+        }
+        let scanout = scanout_builder.build()?;
+        Ok(SurfaceDmabufFeedback { render, scanout })
+    }
+
+    pub(crate) fn display_group_teardown(
+        &mut self,
+        niri: &mut Niri,
+        key: &str,
+    ) -> anyhow::Result<()> {
+        if self.display_groups.groups.contains_key(key) {
+            let group = self.display_groups.groups.get_mut(key).unwrap();
+            if let Some(token) = group.completion_watchdog.take() {
+                niri.event_loop.remove(token);
+            }
+            let primary = &group.plan.members[group.plan.primary];
+            let primary_key = (primary.node, primary.crtc);
+            let output = niri
+                .global_space
+                .outputs()
+                .find(|output| {
+                    let state: &TtyOutputState = output.user_data().get().unwrap();
+                    (state.node, state.crtc) == primary_key
+                })
+                .cloned();
+            if let Some(output) = output {
+                // Public lifetime ends immediately. Potentially scanned-out resources move to the
+                // quarantine below and cannot be reused until every disable is confirmed.
+                niri.remove_output(&output);
+            }
+            for member in &group.plan.members {
+                self.crtc_events
+                    .entry((member.node, member.crtc))
+                    .or_default()
+                    .begin_generation();
+            }
+            group.frames.take_pending();
+            let generation = group.generation;
+            self.display_groups.quarantine_live(key).unwrap();
+            warn!(
+                group = key,
+                generation,
+                public = false,
+                quarantined = true,
+                "display-group logical output withdrawn; retaining hardware resources until every member is retired"
+            );
+        }
+
+        if !self.display_groups.quarantined.contains_key(key) {
+            return Ok(());
+        }
+
+        match self.clear_quarantined_display_group(niri, key) {
+            Ok(()) => Ok(()),
+            Err(err) => {
+                self.arm_display_group_quarantine_retry(niri, key);
+                Err(err)
+            }
+        }
+    }
+
+    fn clear_quarantined_display_group(
+        &mut self,
+        niri: &mut Niri,
+        key: &str,
+    ) -> anyhow::Result<()> {
+        let Some(quarantine) = self.display_groups.quarantined.get(key) else {
+            return Ok(());
+        };
+        let members = Arc::clone(&quarantine.group.plan).members.clone();
+        let mut lifecycle = quarantine.lifecycle;
+        let mut error = None;
+        for (member_idx, member) in members.iter().enumerate() {
+            if lifecycle.is_retired(member_idx) {
+                continue;
+            }
+            let Some(surface) = self
+                .devices
+                .get_mut(&member.node)
+                .and_then(|device| device.surfaces.get_mut(&member.crtc))
+            else {
+                // Removing a DRM device retires all of its KMS objects by definition.
+                lifecycle.confirm_retired(member_idx);
+                continue;
+            };
+            match surface.compositor.clear() {
+                Ok(()) => {
+                    lifecycle.confirm_retired(member_idx);
+                }
+                Err(err) => error = Some(anyhow!(err)),
+            }
+        }
+        self.display_groups
+            .quarantined
+            .get_mut(key)
+            .unwrap()
+            .lifecycle = lifecycle;
+        if !lifecycle.is_complete() {
+            debug_assert_eq!(lifecycle.disable_failed(), TeardownCommand::RetryDisable);
+            return Err(error
+                .unwrap_or_else(|| anyhow!("display-group disable remains incomplete"))
+                .context("could not disable every quarantined display-group member"));
+        }
+
+        let (generation, quarantine_duration) = {
+            let quarantine = self.display_groups.quarantined.get(key).unwrap();
+            (quarantine.group.generation, quarantine.entered_at.elapsed())
+        };
+        let mut group = self.display_groups.finish_quarantine(key).unwrap();
+        if let Some(token) = group.completion_watchdog.take() {
+            niri.event_loop.remove(token);
+        }
+        if let Some(recovery) = group.gamma_recovery.take() {
+            debug!(
+                nodes = ?recovery.transaction.states(),
+                "destroying retained display-group gamma recovery blobs"
+            );
+            self.destroy_display_group_gamma_blobs(&group.plan, &recovery.blobs);
+        }
+        for member in &group.plan.members {
+            if let Some(device) = self.devices.get_mut(&member.node) {
+                self.crtc_events
+                    .entry((member.node, member.crtc))
+                    .or_default()
+                    .replace_compositor();
+                if let Some(mut surface) = device.surfaces.remove(&member.crtc) {
+                    if let Some(gamma_props) = &mut surface.gamma_props {
+                        gamma_props.destroy(&device.drm);
+                    }
+                }
+            }
+        }
+        self.display_groups.disable_failures.remove(key);
+        debug!(
+            group = key,
+            generation,
+            quarantine_ms = quarantine_duration.as_millis(),
+            public = false,
+            quarantined = false,
+            "display-group hardware retirement confirmed"
+        );
+        Ok(())
+    }
+
+    fn arm_display_group_quarantine_retry(&mut self, niri: &mut Niri, key: &str) {
+        let Some(quarantine) = self.display_groups.quarantined.get_mut(key) else {
+            return;
+        };
+        if quarantine.retry_token.is_some() {
+            return;
+        }
+        let retry_key = key.to_owned();
+        let token = niri
+            .event_loop
+            .insert_source(
+                Timer::from_duration(Duration::from_secs(30)),
+                move |_, _, state| {
+                    let tty = state.backend.tty();
+                    if let Some(quarantine) = tty.display_groups.quarantined.get_mut(&retry_key) {
+                        quarantine.retry_token = None;
+                    }
+                    if let Err(err) = tty.display_group_teardown(&mut state.niri, &retry_key) {
+                        debug!(
+                            "display-group {retry_key}: low-rate quarantine retry failed: {err:?}"
+                        );
+                    } else {
+                        tty.reconcile_output_config(&mut state.niri, None);
+                    }
+                    TimeoutAction::Drop
+                },
+            )
+            .unwrap();
+        quarantine.retry_token = Some(token);
+    }
+
+    pub(super) fn clear_display_group_members(
+        &mut self,
+        niri: &mut Niri,
+        key: &str,
+    ) -> anyhow::Result<bool> {
+        let Some(group) = self.display_groups.groups.get(key) else {
+            return Ok(false);
+        };
+        let members = group.plan.members.clone();
+        let primary = &group.plan.members[group.plan.primary];
+        let primary_key = (primary.node, primary.crtc);
+
+        // Keep every still-scanning member owned if any device cannot confirm disable.
+        // Cross-device disable cannot be atomic, so retained ownership is the safety net.
+        let mut error = None;
+        for member in &members {
+            let Some(surface) = self
+                .devices
+                .get_mut(&member.node)
+                .and_then(|device| device.surfaces.get_mut(&member.crtc))
+            else {
+                // A removed DRM device has retired its KMS resources by definition.
+                continue;
+            };
+            match surface.compositor.clear() {
+                Ok(_) => {
+                    self.crtc_events
+                        .entry((member.node, member.crtc))
+                        .or_default()
+                        .begin_generation();
+                }
+                Err(err) => error = Some(anyhow!(err)),
+            }
+        }
+        if let Some(error) = error {
+            return Err(error.context("could not disable every display-group member"));
+        }
+
+        let group = self.display_groups.groups.get_mut(key).unwrap();
+        if let Some(token) = group.completion_watchdog.take() {
+            niri.event_loop.remove(token);
+        }
+        let had_pending = group.frames.take_pending().is_some();
+        if had_pending {
+            let output = {
+                niri.global_space
+                    .outputs()
+                    .find(|output| {
+                        let state: &TtyOutputState = output.user_data().get().unwrap();
+                        (state.node, state.crtc) == primary_key
+                    })
+                    .cloned()
+            };
+            if let Some(output) = output {
+                niri.abandon_output_frame(&output);
+            }
+        }
+        Ok(had_pending)
+    }
+
+    pub(super) fn render_display_group(
+        &mut self,
+        niri: &mut Niri,
+        output: &Output,
+        key: &str,
+        target_presentation_time: Duration,
+    ) -> RenderResult {
+        let _span = tracy_client::span!("Tty::render_display_group");
+        let Some(group) = self.display_groups.groups.get(key) else {
+            return RenderResult::Skipped;
+        };
+        if group.frames.has_pending()
+            || group.plan.members.iter().any(|member| {
+                !self
+                    .devices
+                    .get(&member.node)
+                    .is_some_and(|device| device.drm.is_active())
+            })
+        {
+            return RenderResult::Skipped;
+        }
+        let plan = Arc::clone(&group.plan);
+        let event_key = Arc::clone(&group.event_key);
+        let group_generation = group.generation;
+        let previous_scanout = group.member_scanout;
+        let force_composite_next = group.force_composite_next;
+
+        let scale = Scale::from(output.current_scale().fractional_scale());
+        let (restrict_primary, disable_direct, wait_for_completion) = {
+            let config = self.config.borrow();
+            (
+                config.debug.restrict_primary_scanout_to_matching_format,
+                config.debug.disable_direct_scanout,
+                config.debug.wait_for_frame_completion_before_queueing,
+            )
+        };
+        let primary_scanout_flag = if restrict_primary {
+            FrameFlags::ALLOW_PRIMARY_PLANE_SCANOUT
+        } else {
+            FrameFlags::ALLOW_PRIMARY_PLANE_SCANOUT_ANY
+        };
+        let mut flags = primary_scanout_flag;
+        if disable_direct || plan.composited_only {
+            flags.remove(primary_scanout_flag);
+        }
+
+        if force_composite_next {
+            flags.remove(primary_scanout_flag);
+            for member in &plan.members {
+                if let Some(surface) = self
+                    .devices
+                    .get_mut(&member.node)
+                    .and_then(|device| device.surfaces.get_mut(&member.crtc))
+                {
+                    surface.compositor.reset_buffers();
+                }
+            }
+        }
+
+        let Ok(mut prepared) = self.prepare_display_group_members(
+            niri,
+            output,
+            key,
+            &plan,
+            scale,
+            flags,
+            wait_for_completion,
+        ) else {
+            // `render_frame` performs Smithay's TEST_ONLY preparation. Do not submit any member
+            // unless every member that needed a new frame prepared successfully. A later render
+            // replaces and drops any retained `next_frame` before retrying.
+            queue_estimated_vblank_timer(niri, output.clone(), target_presentation_time);
+            return RenderResult::Skipped;
+        };
+
+        // Smithay makes the primary-plane decision per DrmCompositor. If any participating member
+        // needs composition (or another member failed to prepare), re-render every direct member
+        // with direct scanout disabled before submitting anything. This keeps one logical frame
+        // entirely direct or entirely composited and avoids mixed client/swapchain ownership.
+        let effective_scanout = prepared.iter().enumerate().map(|(member, frame)| {
+            frame
+                .submit
+                .then_some(frame.scanout_kind)
+                .or(previous_scanout[member])
+        });
+        let force_composite = display_group_requires_composition(effective_scanout);
+        if flags.contains(primary_scanout_flag) && force_composite {
+            flags.remove(primary_scanout_flag);
+            // A direct/composited transition must not leave one member on a client buffer while
+            // another member uses a compositor slot. Invalidate every member so the retry is one
+            // complete composited logical frame, including members with no new local damage.
+            for member in &plan.members {
+                if let Some(surface) = self
+                    .devices
+                    .get_mut(&member.node)
+                    .and_then(|device| device.surfaces.get_mut(&member.crtc))
+                {
+                    surface.compositor.reset_buffers();
+                }
+            }
+            let Ok(composited) = self.prepare_display_group_members(
+                niri,
+                output,
+                key,
+                &plan,
+                scale,
+                flags,
+                wait_for_completion,
+            ) else {
+                queue_estimated_vblank_timer(niri, output.clone(), target_presentation_time);
+                return RenderResult::Skipped;
+            };
+            prepared = composited;
+        }
+
+        let prepared_members = prepared
+            .iter()
+            .map(|frame| frame.submit)
+            .collect::<Vec<_>>();
+        let mut sequence_floors = [0; MAX_GROUP_MEMBERS];
+        let devices = &mut self.devices;
+        let crtc_events = &mut self.crtc_events;
+        let submission = submit_prepared_members(
+            plan.members.len(),
+            |member| prepared_members[member],
+            |member_idx| {
+                let member = &plan.members[member_idx];
+                let Some(surface) = devices
+                    .get_mut(&member.node)
+                    .and_then(|device| device.surfaces.get_mut(&member.crtc))
+                else {
+                    return false;
+                };
+                let tracker = crtc_events.entry((member.node, member.crtc)).or_default();
+                let submission = tracker.enqueue();
+                sequence_floors[member_idx] = submission.sequence_floor;
+                let data = SurfaceFrameData::DisplayGroupMember {
+                    key: Arc::clone(&event_key),
+                    member: member_idx,
+                    submission,
+                };
+                if let Err(err) = surface.compositor.queue_frame(data) {
+                    tracker.cancel(submission);
+                    warn!("display-group {key}: member submission failed: {err}");
+                    surface.compositor.reset_buffers();
+                    return false;
+                }
+                true
+            },
+        );
+        if submission.partial_failure {
+            self.display_groups.metrics.partial_submissions = self
+                .display_groups
+                .metrics
+                .partial_submissions
+                .saturating_add(1);
+            warn!(
+                group = key,
+                generation = group_generation,
+                intended_mask = (1_u8 << plan.members.len()) - 1,
+                submitted_mask = submission.submitted_mask,
+                public = true,
+                quarantined = false,
+                "display-group member submission was partial; logical presentation will be discarded"
+            );
+        }
+
+        let fence_waits = prepared
+            .iter()
+            .filter(|frame| !frame.fence_wait.is_zero())
+            .count() as u64;
+        let fence_wait_nanos = prepared
+            .iter()
+            .map(|frame| frame.fence_wait.as_nanos())
+            .sum::<u128>();
+        self.display_groups.metrics.fence_waits = self
+            .display_groups
+            .metrics
+            .fence_waits
+            .saturating_add(fence_waits);
+        self.display_groups.metrics.fence_wait_nanos = self
+            .display_groups
+            .metrics
+            .fence_wait_nanos
+            .saturating_add(fence_wait_nanos);
+        trace!(
+            group = key,
+            generation = group_generation,
+            fence_waits,
+            fence_wait_us = fence_wait_nanos / 1_000,
+            "display-group frame synchronization"
+        );
+        let outcome = match submission.outcome() {
+            GroupSubmissionOutcome::NoSubmission => None,
+            GroupSubmissionOutcome::Complete { submitted_mask } => {
+                Some((submitted_mask, LogicalFrameOutcome::Complete))
+            }
+            GroupSubmissionOutcome::PartialFailure { submitted_mask } => {
+                Some((submitted_mask, LogicalFrameOutcome::PartialFailure))
+            }
+        };
+
+        // No-damage members still describe visible logical fragments. A failed submission does
+        // not: its states belong to a physical frame that never reached KMS.
+        let mut merged_states = RenderElementStates::default();
+        for (member, frame) in prepared.iter().enumerate() {
+            if !frame.submit || submission.submitted_mask & (1 << member) != 0 {
+                merge_render_element_states(&mut merged_states, &frame.states);
+            }
+        }
+
+        let Some((submitted_mask, pending_outcome)) = outcome else {
+            if submission.partial_failure {
+                queue_estimated_vblank_timer(niri, output.clone(), target_presentation_time);
+                return RenderResult::Skipped;
+            }
+            if let Some(group) = self.display_groups.groups.get_mut(key) {
+                for (member, frame) in prepared.iter().enumerate() {
+                    group.member_scanout[member] = Some(frame.scanout_kind);
+                }
+            }
+            niri.update_primary_scanout_output(output, &merged_states);
+            if let Some(dmabuf_feedback) = self
+                .display_groups
+                .groups
+                .get(key)
+                .and_then(|group| group.dmabuf_feedback.as_ref())
+            {
+                niri.send_dmabuf_feedbacks(output, dmabuf_feedback, &merged_states);
+            }
+            return RenderResult::NoDamage;
+        };
+
+        if pending_outcome == LogicalFrameOutcome::Complete {
+            niri.update_primary_scanout_output(output, &merged_states);
+            if let Some(dmabuf_feedback) = self
+                .display_groups
+                .groups
+                .get(key)
+                .and_then(|group| group.dmabuf_feedback.as_ref())
+            {
+                niri.send_dmabuf_feedbacks(output, dmabuf_feedback, &merged_states);
+            }
+        }
+        let feedback = niri.take_presentation_feedbacks(output, &merged_states);
+        let group = self.display_groups.groups.get_mut(key).unwrap();
+        for (member, frame) in prepared.iter().enumerate() {
+            if !frame.submit || submitted_mask & (1 << member) != 0 {
+                group.member_scanout[member] = Some(frame.scanout_kind);
+            }
+        }
+        group.force_composite_next = pending_outcome == LogicalFrameOutcome::PartialFailure;
+        group.frames.submit(
+            PendingDisplayGroupFrame {
+                feedback: (pending_outcome == LogicalFrameOutcome::Complete).then_some(feedback),
+                target_presentation_time,
+            },
+            submitted_mask,
+            sequence_floors,
+            pending_outcome,
+        );
+
+        let output_state = niri.output_state.get_mut(output).unwrap();
+        let redraw_needed = pending_outcome == LogicalFrameOutcome::PartialFailure;
+        let new_state = RedrawState::WaitingForVBlank { redraw_needed };
+        match mem::replace(&mut output_state.redraw_state, new_state) {
+            RedrawState::Queued => (),
+            RedrawState::WaitingForEstimatedVBlankAndQueued(token) => {
+                niri.event_loop.remove(token);
+            }
+            state => error!("display-group {key}: unexpected pre-submit state {state:?}"),
+        }
+        if pending_outcome == LogicalFrameOutcome::Complete {
+            output_state.frame_callback_sequence =
+                output_state.frame_callback_sequence.wrapping_add(1);
+        }
+
+        self.arm_display_group_watchdog(niri, key);
+        RenderResult::Submitted
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn prepare_display_group_members(
+        &mut self,
+        niri: &Niri,
+        output: &Output,
+        key: &str,
+        plan: &OutputGroupPlan,
+        scale: Scale<f64>,
+        flags: FrameFlags,
+        wait_for_completion: bool,
+    ) -> Result<Vec<PreparedDisplayGroupMember>, ()> {
+        let targets = plan
+            .members
+            .iter()
+            .map(|member| {
+                let Some(device) = self.devices.get(&member.node) else {
+                    warn!("display-group {key}: member device disappeared before rendering");
+                    return Err(());
+                };
+                let Some(surface) = device.surfaces.get(&member.crtc) else {
+                    warn!("display-group {key}: member surface disappeared before rendering");
+                    return Err(());
+                };
+                Ok((
+                    device.render_node.unwrap_or(self.primary_render_node),
+                    surface.compositor.format(),
+                ))
+            })
+            .collect::<Result<Vec<_>, ()>>()?;
+        let mut prepared = (0..plan.members.len()).map(|_| None).collect::<Vec<_>>();
+        let mut processed = vec![false; plan.members.len()];
+        let primary_render_node = self.primary_render_node;
+        let gpu_manager = &mut self.gpu_manager;
+        let devices = &mut self.devices;
+
+        for seed in 0..plan.members.len() {
+            if processed[seed] {
+                continue;
+            }
+            let target = targets[seed];
+            let indices = targets
+                .iter()
+                .enumerate()
+                .filter_map(|(idx, candidate)| {
+                    (!processed[idx] && *candidate == target).then_some(idx)
+                })
+                .collect::<Vec<_>>();
+            for &idx in &indices {
+                processed[idx] = true;
+            }
+
+            let mut renderer = match gpu_manager.renderer(&primary_render_node, &target.0, target.1)
+            {
+                Ok(renderer) => renderer,
+                Err(err) => {
+                    warn!("display-group {key}: member renderer failed: {err:?}");
+                    return Err(());
+                }
+            };
+            let ctx = RenderCtx {
+                renderer: &mut renderer,
+                target: RenderTarget::Output,
+                xray: None,
+            };
+            // Render elements depend on the target MultiRenderer. Generate the logical scene once
+            // for every distinct (render node, format) target and reuse it for all matching group
+            // members, which is one traversal for the common same-render-node case.
+            let elements = niri.render_to_vec(ctx, output, true);
+            for idx in indices {
+                let member = &plan.members[idx];
+                let Some(surface) = devices
+                    .get_mut(&member.node)
+                    .and_then(|device| device.surfaces.get_mut(&member.crtc))
+                else {
+                    warn!("display-group {key}: member surface disappeared before rendering");
+                    return Err(());
+                };
+                let frame = Self::prepare_display_group_member(
+                    surface,
+                    &mut renderer,
+                    &elements,
+                    key,
+                    member,
+                    scale,
+                    flags,
+                    wait_for_completion,
+                )?;
+                prepared[idx] = Some(frame);
+            }
+        }
+
+        prepared.into_iter().collect::<Option<Vec<_>>>().ok_or(())
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn prepare_display_group_member<'render>(
+        surface: &mut Surface,
+        renderer: &mut TtyRenderer<'render>,
+        elements: &[OutputRenderElements<TtyRenderer<'render>>],
+        key: &str,
+        member: &GroupMemberPlan,
+        scale: Scale<f64>,
+        flags: FrameFlags,
+        wait_for_completion: bool,
+    ) -> Result<PreparedDisplayGroupMember, ()> {
+        let rect = member.rect;
+        let (x, y, width, height) = match (
+            i32::try_from(rect.x),
+            i32::try_from(rect.y),
+            i32::try_from(rect.width),
+            i32::try_from(rect.height),
+        ) {
+            (Ok(x), Ok(y), Ok(width), Ok(height)) => (x, y, width, height),
+            _ => {
+                warn!("display-group {key}: member rectangle exceeds renderer coordinates");
+                return Err(());
+            }
+        };
+        let crop = Rectangle::<i32, Physical>::new((x, y).into(), (width, height).into());
+        let member_elements = elements
+            .iter()
+            .filter_map(|element| CropRenderElement::from_element(element, scale, crop))
+            .map(|element| {
+                RelocateRenderElement::from_element(
+                    element,
+                    Point::from((-x, -y)),
+                    Relocate::Relative,
+                )
+            })
+            .collect::<Vec<_>>();
+        let result = match surface.compositor.render_frame::<_, _>(
+            renderer,
+            &member_elements,
+            [0.; 4],
+            flags,
+        ) {
+            Ok(result) => result,
+            Err(err) => {
+                warn!("display-group {key}: member render failed: {err}");
+                surface.compositor.reset_buffers();
+                return Err(());
+            }
+        };
+        let scanout_kind = if matches!(&result.primary_element, PrimaryPlaneElement::Element(_)) {
+            DisplayGroupScanoutKind::Direct
+        } else {
+            DisplayGroupScanoutKind::Composited
+        };
+        let mut fence_wait = Duration::ZERO;
+        if result.needs_sync() || wait_for_completion {
+            if let PrimaryPlaneElement::Swapchain(element) = &result.primary_element {
+                let started = Instant::now();
+                if let Err(err) = element.sync.wait() {
+                    warn!("display-group {key}: render wait failed: {err:?}");
+                }
+                fence_wait = started.elapsed();
+            }
+        }
+        Ok(PreparedDisplayGroupMember {
+            states: result.states,
+            scanout_kind,
+            // Never flip an alternate undrawn slot for an unchanged member: it contains an older
+            // frame. Its states are nevertheless part of the logical output state.
+            submit: !result.is_empty,
+            fence_wait,
+        })
+    }
+
+    pub(super) fn arm_display_group_watchdog(&mut self, niri: &mut Niri, key: &str) {
+        let Some(group) = self.display_groups.groups.get_mut(key) else {
+            return;
+        };
+        if !group.frames.has_pending() {
+            return;
+        }
+        if let Some(old) = group.completion_watchdog.take() {
+            niri.event_loop.remove(old);
+        }
+
+        let watchdog_key = key.to_owned();
+        let token = niri
+            .event_loop
+            .insert_source(
+                // One logical frame intentionally waits for all submitted members. DisplayLink
+                // commonly adds 10-20 ms of USB scheduling jitter, so this is a liveness timeout,
+                // not a frame-latency threshold.
+                Timer::from_duration(Duration::from_millis(1500)),
+                move |_, _, state| {
+                    state
+                        .backend
+                        .tty()
+                        .display_group_watchdog(&mut state.niri, &watchdog_key);
+                    TimeoutAction::Drop
+                },
+            )
+            .unwrap();
+        self.display_groups
+            .groups
+            .get_mut(key)
+            .unwrap()
+            .completion_watchdog = Some(token);
+    }
+
+    fn display_group_watchdog(&mut self, niri: &mut Niri, key: &str) {
+        let (drm_active, generation) = {
+            let Some(group) = self.display_groups.groups.get_mut(key) else {
+                return;
+            };
+            group.completion_watchdog = None;
+            if !group.frames.has_pending() {
+                return;
+            }
+            (
+                group.plan.members.iter().all(|member| {
+                    self.devices
+                        .get(&member.node)
+                        .is_some_and(|device| device.drm.is_active())
+                }),
+                group.generation,
+            )
+        };
+        self.display_groups.metrics.watchdog_timeouts = self
+            .display_groups
+            .metrics
+            .watchdog_timeouts
+            .saturating_add(1);
+        warn!(
+            group = key,
+            generation,
+            public = true,
+            quarantined = false,
+            "display-group frame completion timed out after 1.5s; normal EVDI jitter is tolerated"
+        );
+        if let Err(err) = self.display_group_teardown(niri, key) {
+            let policy = record_display_group_failure(
+                &mut self.display_groups.disable_failures,
+                DisplayGroupFailureScope::Disable,
+                drm_active,
+                &niri.event_loop,
+                key.to_owned(),
+                TiledFailureClass::Retryable,
+            );
+            warn!(
+                "display-group {key}: watchdog teardown retained: {err:?}; failure policy: {policy:?}"
+            );
+            return;
+        }
+        record_display_group_failure(
+            &mut self.display_groups.formation_failures,
+            DisplayGroupFailureScope::Formation,
+            drm_active,
+            &niri.event_loop,
+            key.to_owned(),
+            TiledFailureClass::Retryable,
+        );
+        niri.event_loop.insert_idle(|state| {
+            state
+                .backend
+                .tty()
+                .reconcile_output_config(&mut state.niri, None);
+        });
+    }
+
+    pub(super) fn on_display_group_vblank(
+        &mut self,
+        niri: &mut Niri,
+        key: &str,
+        member: usize,
+        meta: DrmEventMetadata,
+    ) {
+        let event_time = match meta.time {
+            DrmEventTime::Monotonic(time) => time,
+            DrmEventTime::Realtime(_) => Duration::ZERO,
+        };
+        let Some(group) = self.display_groups.groups.get_mut(key) else {
+            return;
+        };
+        let completion = group.frames.record(
+            member,
+            MemberEvent {
+                sequence: meta.sequence,
+                time: event_time,
+            },
+        );
+        let completion = match completion {
+            LogicalFrameEvent::Rejected => {
+                self.display_groups.metrics.stale_or_duplicate_events = self
+                    .display_groups
+                    .metrics
+                    .stale_or_duplicate_events
+                    .saturating_add(1);
+                trace!("display-group {key}: duplicate or stale event from member {member}");
+                return;
+            }
+            LogicalFrameEvent::Waiting => return,
+            LogicalFrameEvent::Completed(completion) => completion,
+        };
+        let presentation = completion.frame;
+        let aggregate = completion.event;
+        let disposition = completion.disposition;
+        if let Some(token) = group.completion_watchdog.take() {
+            niri.event_loop.remove(token);
+        }
+        let primary = &group.plan.members[group.plan.primary];
+        let primary_key = (primary.node, primary.crtc);
+        let name = group.plan.name.connector.clone();
+        let refresh_interval = pacing_refresh_interval(&[group.plan.pacing_refresh]);
+        let plan = Arc::clone(&group.plan);
+
+        let Some(output) = niri
+            .global_space
+            .outputs()
+            .find(|output| {
+                let state: &TtyOutputState = output.user_data().get().unwrap();
+                (state.node, state.crtc) == primary_key
+            })
+            .cloned()
+        else {
+            error!("display-group {key}: missing logical output");
+            return;
+        };
+        let Some(output_state) = niri.output_state.get_mut(&output) else {
+            error!("display-group {key}: missing logical output state");
+            return;
+        };
+        let redraw_needed = match mem::replace(&mut output_state.redraw_state, RedrawState::Idle) {
+            RedrawState::WaitingForVBlank { redraw_needed } => redraw_needed,
+            state => {
+                error!("display-group {key}: unexpected completed-frame state {state:?}");
+                true
+            }
+        };
+
+        let PendingDisplayGroupFrame {
+            feedback,
+            target_presentation_time,
+        } = presentation;
+        if disposition == LogicalFrameDisposition::DiscardPartial {
+            // The submitted members have now safely retired their buffers, but this was never one
+            // logical presentation. Discard its feedback, force a fully composited repair frame,
+            // and leave the logical sequence and frame clock untouched.
+            drop(feedback);
+            for member in &plan.members {
+                if let Some(surface) = self
+                    .devices
+                    .get_mut(&member.node)
+                    .and_then(|device| device.surfaces.get_mut(&member.crtc))
+                {
+                    surface.compositor.reset_buffers();
+                }
+            }
+            niri.queue_redraw(&output);
+            return;
+        }
+        let LogicalFrameDisposition::Present {
+            sequence: logical_sequence,
+        } = disposition
+        else {
+            unreachable!()
+        };
+
+        let now = get_monotonic_time();
+        let presentation_time = if self.config.borrow().debug.emulate_zero_presentation_time {
+            Duration::ZERO
+        } else {
+            aggregate.time
+        };
+        let time = if presentation_time.is_zero() {
+            now
+        } else {
+            presentation_time
+        };
+        let refresh = refresh_interval
+            .map(Refresh::Fixed)
+            .unwrap_or(Refresh::Unknown);
+        let mut flags =
+            wp_presentation_feedback::Kind::Vsync | wp_presentation_feedback::Kind::HwCompletion;
+        if !presentation_time.is_zero() {
+            flags.insert(wp_presentation_feedback::Kind::HwClock);
+        }
+        let Some(mut feedback) = feedback else {
+            error!("display-group {key}: complete frame has no presentation feedback");
+            niri.queue_redraw(&output);
+            return;
+        };
+        feedback.presented::<_, smithay::utils::Monotonic>(
+            time,
+            refresh,
+            u64::from(logical_sequence),
+            flags,
+        );
+        if !presentation_time.is_zero() {
+            trace!(
+                "display-group {name}: presentation misprediction {:?}",
+                presentation_time.saturating_sub(target_presentation_time)
+            );
+        }
+
+        output_state.last_drm_sequence = Some(logical_sequence);
+        output_state.frame_clock.presented(presentation_time);
+        if redraw_needed || output_state.unfinished_animations_remain {
+            niri.queue_redraw(&output);
+        } else {
+            niri.send_frame_callbacks(&output);
+        }
+    }
+
+    pub(super) fn display_group_gamma_size(&self, key: &str) -> anyhow::Result<u32> {
+        let group = self
+            .display_groups
+            .groups
+            .get(key)
+            .context("missing display group")?;
+        let mut common_size = None;
+
+        for member in &group.plan.members {
+            let device = self
+                .devices
+                .get(&member.node)
+                .context("missing display-group member device")?;
+            let surface = device
+                .surfaces
+                .get(&member.crtc)
+                .context("missing display-group member surface")?;
+            let gamma_props = surface
+                .gamma_props
+                .as_ref()
+                .context("display-group member lacks atomic GAMMA_LUT support")?;
+            let size = gamma_props.gamma_size(&device.drm)?;
+            if let Some(common_size) = common_size {
+                ensure!(
+                    size == common_size,
+                    "display-group members have different gamma sizes"
+                );
+            } else {
+                common_size = Some(size);
+            }
+        }
+
+        common_size.context("display group has no members")
+    }
+
+    fn destroy_display_group_gamma_blobs(
+        &self,
+        plan: &OutputGroupPlan,
+        blobs: &[Option<NonZeroU64>],
+    ) {
+        for (member, blob) in plan.members.iter().zip(blobs.iter().copied()) {
+            if let Some(device) = self.devices.get(&member.node) {
+                GammaProps::destroy_blob(&device.drm, blob);
+            }
+        }
+    }
+
+    /// Applies one logical gamma request to every member. Atomic KMS cannot span DRM devices, so
+    /// each device receives one request and any already-committed device is rolled back if a later
+    /// device fails. Old blobs remain owned until every device has accepted the new state.
+    fn commit_display_group_gamma_node(
+        &self,
+        plan: &OutputGroupPlan,
+        node: DrmNode,
+        new_blobs: Option<&[Option<NonZeroU64>]>,
+    ) -> anyhow::Result<()> {
+        let device = self
+            .devices
+            .get(&node)
+            .context("missing display-group member device")?;
+        let mut request = AtomicModeReq::new();
+        for (idx, member) in plan.members.iter().enumerate() {
+            if member.node != node {
+                continue;
+            }
+            let gamma_props = device
+                .surfaces
+                .get(&member.crtc)
+                .and_then(|surface| surface.gamma_props.as_ref())
+                .context("display-group member lacks atomic GAMMA_LUT support")?;
+            let blob = new_blobs.map_or_else(|| gamma_props.previous_blob(), |blobs| blobs[idx]);
+            gamma_props.add_blob_to_request(&mut request, blob);
+        }
+        device
+            .drm
+            .atomic_commit(AtomicCommitFlags::empty(), request)
+            .context("error applying display-group GAMMA_LUT properties")
+    }
+
+    pub(super) fn set_display_group_gamma(
+        &mut self,
+        key: &str,
+        ramp: Option<&[u16]>,
+    ) -> anyhow::Result<()> {
+        let plan = self
+            .display_groups
+            .groups
+            .get(key)
+            .context("missing display group")?
+            .plan
+            .clone();
+        let gamma_size = self.display_group_gamma_size(key)? as usize;
+        if let Some(ramp) = ramp {
+            ensure!(gamma_size != 0, "setting gamma is not supported");
+            ensure!(ramp.len() == gamma_size * 3, "wrong gamma length");
+        }
+
+        // Allocate and validate every blob before changing any CRTC.
+        let mut blobs = Vec::with_capacity(plan.members.len());
+        for member in &plan.members {
+            let result = (|| {
+                let device = self
+                    .devices
+                    .get(&member.node)
+                    .context("missing display-group member device")?;
+                let surface = device
+                    .surfaces
+                    .get(&member.crtc)
+                    .context("missing display-group member surface")?;
+                let gamma_props = surface
+                    .gamma_props
+                    .as_ref()
+                    .context("display-group member lacks atomic GAMMA_LUT support")?;
+                gamma_props.create_blob(&device.drm, ramp)
+            })();
+            match result {
+                Ok(blob) => blobs.push(blob),
+                Err(err) => {
+                    self.destroy_display_group_gamma_blobs(&plan, &blobs);
+                    return Err(err);
+                }
+            }
+        }
+
+        let mut nodes = Vec::new();
+        for member in &plan.members {
+            if !nodes.contains(&member.node) {
+                nodes.push(member.node);
+            }
+        }
+        let mut transaction = GammaTransaction::new(nodes.iter().copied());
+
+        let mut committed_nodes = Vec::new();
+        for node in nodes {
+            let result = self.commit_display_group_gamma_node(&plan, node, Some(&blobs));
+
+            if let Err(err) = result {
+                // Cross-device atomicity is emulated by restoring every device that committed.
+                for committed_node in committed_nodes.iter().copied() {
+                    if let Err(rollback_err) =
+                        self.commit_display_group_gamma_node(&plan, committed_node, None)
+                    {
+                        transaction.mark_rollback(committed_node, false);
+                        warn!(
+                            ?committed_node,
+                            "error rolling back display-group gamma: {rollback_err:?}"
+                        );
+                    } else {
+                        transaction.mark_rollback(committed_node, true);
+                    }
+                }
+                if transaction.has_unknown() {
+                    self.display_groups
+                        .groups
+                        .get_mut(key)
+                        .unwrap()
+                        .gamma_recovery = Some(DisplayGroupGammaRecovery { blobs, transaction });
+                    return Err(DisplayGroupGammaUnknown {
+                        key: key.to_owned(),
+                    }
+                    .into());
+                }
+                self.destroy_display_group_gamma_blobs(&plan, &blobs);
+                return Err(err);
+            }
+            transaction.mark_new(node);
+            committed_nodes.push(node);
+        }
+
+        for (member, blob) in plan.members.iter().zip(blobs) {
+            let device = self
+                .devices
+                .get_mut(&member.node)
+                .context("missing display-group member device")?;
+            let gamma_props = device
+                .surfaces
+                .get_mut(&member.crtc)
+                .and_then(|surface| surface.gamma_props.as_mut())
+                .context("display-group member lacks atomic GAMMA_LUT support")?;
+            gamma_props.install_blob(&device.drm, blob);
+        }
+        Ok(())
+    }
+
+    pub(super) fn restore_display_group_gamma(&self, key: &str) -> anyhow::Result<()> {
+        let plan = &self
+            .display_groups
+            .groups
+            .get(key)
+            .context("missing display group")?
+            .plan;
+        let mut committed_nodes = Vec::new();
+        for member in &plan.members {
+            if committed_nodes.contains(&member.node) {
+                continue;
+            }
+            if let Err(err) = self.commit_display_group_gamma_node(plan, member.node, None) {
+                return Err(anyhow!(DisplayGroupGammaUnknown {
+                    key: key.to_owned(),
+                })
+                .context(format!(
+                    "error restoring display-group GAMMA_LUT properties on {node:?}: {err:?}",
+                    node = member.node
+                )));
+            }
+            committed_nodes.push(member.node);
+        }
+        Ok(())
+    }
+
+    pub(super) fn schedule_display_group_debounce(&mut self, niri: &mut Niri) {
+        if !self
+            .config
+            .borrow()
+            .outputs
+            .0
+            .iter()
+            .any(|output| output.display_group.is_some())
+        {
+            return;
+        }
+
+        const QUIET: Duration = Duration::from_millis(750);
+        const CAP: Duration = Duration::from_secs(3);
+
+        let now = Instant::now();
+        let started = self
+            .display_groups
+            .debounce
+            .as_ref()
+            .map(|debounce| debounce.started)
+            .unwrap_or(now);
+        if let Some(old) = self.display_groups.debounce.take() {
+            niri.event_loop.remove(old.token);
+        }
+        self.display_groups.debounce_generation = self
+            .display_groups
+            .debounce_generation
+            .wrapping_add(1)
+            .max(1);
+        let generation = self.display_groups.debounce_generation;
+        let remaining = (started + CAP).saturating_duration_since(now);
+        let delay = QUIET.min(remaining);
+        let token = niri
+            .event_loop
+            .insert_source(Timer::from_duration(delay), move |_, _, state| {
+                let current = state
+                    .backend
+                    .tty()
+                    .display_groups
+                    .debounce
+                    .as_ref()
+                    .is_some_and(|debounce| debounce.generation == generation);
+                if current {
+                    state.backend.tty().display_groups.debounce = None;
+                    state
+                        .backend
+                        .tty()
+                        .reconcile_output_config(&mut state.niri, None);
+                }
+                TimeoutAction::Drop
+            })
+            .unwrap();
+        self.display_groups.debounce = Some(DisplayGroupDebounce {
+            token,
+            started,
+            generation,
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn display_group_direct_scanout_is_all_or_nothing() {
+        assert!(!display_group_requires_composition([
+            Some(DisplayGroupScanoutKind::Direct),
+            Some(DisplayGroupScanoutKind::Direct),
+        ]));
+        assert!(display_group_requires_composition([
+            Some(DisplayGroupScanoutKind::Direct),
+            Some(DisplayGroupScanoutKind::Composited),
+        ]));
+        assert!(display_group_requires_composition([
+            Some(DisplayGroupScanoutKind::Direct),
+            None,
+        ]));
+    }
+}
