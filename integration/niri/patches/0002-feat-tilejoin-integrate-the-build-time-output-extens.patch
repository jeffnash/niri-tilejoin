+
+fn validate_tiled_direct_geometry(
+    output_transform: Transform,
+    output_geometry: Rectangle<i32, Physical>,
+    element_geometry: Rectangle<i32, Physical>,
+    element_alpha: f32,
+    element_opaque_regions: impl IntoIterator<Item = Rectangle<i32, Physical>>,
+    element_transform: Transform,
+) -> Result<(), TiledDirectScanoutRejection> {
+    if output_transform != Transform::Normal || element_transform != Transform::Normal {
+        return Err(TiledDirectScanoutRejection::TransformOrScale);
+    }
+    if element_geometry != output_geometry {
+        return Err(TiledDirectScanoutRejection::OverlayOrCursor);
+    }
+    if element_alpha < 1.
+        || !Rectangle::subtract_rects_many([output_geometry], element_opaque_regions).is_empty()
+    {
+        return Err(TiledDirectScanoutRejection::Opacity);
+    }
+    Ok(())
+}
+
+fn tiled_direct_scanout_candidate<'render>(
+    renderer: &mut TtyRenderer<'render>,
+    output: &Output,
+    elements: &[OutputRenderElements<TtyRenderer<'render>>],
+    metadata: &TiledDmabufFeedback,
+) -> Result<TiledDirectScanoutCandidate, TiledDirectScanoutRejection> {
+    let mode = output
+        .current_mode()
+        .ok_or(TiledDirectScanoutRejection::Dimensions)?;
+    let output_geometry = Rectangle::from_size(mode.size);
+    let scale = Scale::from(output.current_scale().fractional_scale());
+
+    let element = elements
+        .iter()
+        .find(|element| {
+            element.alpha() > 0.
+                && element
+                    .geometry(scale)
+                    .intersection(output_geometry)
+                    .is_some()
+        })
+        .ok_or(TiledDirectScanoutRejection::NoVisibleElement)?;
+    validate_tiled_direct_geometry(
+        output.current_transform(),
+        output_geometry,
+        element.geometry(scale),
+        element.alpha(),
+        element.opaque_regions(scale).iter().copied(),
+        element.transform(),
+    )?;
+
+    let storage = element
+        .underlying_storage(renderer)
+        .ok_or(TiledDirectScanoutRejection::UnsupportedStorage)?;
+    let UnderlyingStorage::Wayland(buffer) = storage else {
+        return Err(TiledDirectScanoutRejection::UnsupportedStorage);
+    };
+    let dmabuf = get_dmabuf(buffer)
+        .map_err(|_| TiledDirectScanoutRejection::UnsupportedStorage)?
+        .clone();
+    if dmabuf.node() != metadata.render_node {
+        return Err(TiledDirectScanoutRejection::DeviceMismatch);
+    }
+    if !metadata.scanout_formats.contains(&dmabuf.format()) {
+        return Err(TiledDirectScanoutRejection::UnsupportedFormatModifier);
+    }
+    if dmabuf.size().w != mode.size.w || dmabuf.size().h != mode.size.h {
+        return Err(TiledDirectScanoutRejection::Dimensions);
+    }
+
+    let src = element.src();
+    if src.loc != (0., 0.).into() {
+        return Err(TiledDirectScanoutRejection::PlaneCropping);
+    }
+    if src.size != dmabuf.size().to_f64() {
+        return Err(TiledDirectScanoutRejection::TransformOrScale);
+    }
+
+    Ok(TiledDirectScanoutCandidate {
+        buffer: buffer.clone(),
+        dmabuf,
+        element_id: element.id().clone(),
+    })
+}
+
+fn tiled_direct_scanout_states(
+    element_ids: impl IntoIterator<Item = Id>,
+    candidate_id: &Id,
+    visible_area: usize,
+) -> RenderElementStates {
+    let mut states = RenderElementStates::default();
+    for id in element_ids {
+        if &id == candidate_id {
+            states.states.insert(
+                id,
+                RenderElementState {
+                    visible_area,
+                    presentation_state: RenderElementPresentationState::ZeroCopy,
+                    needs_capture: false,
+                },
+            );
+        } else {
+            states.states.entry(id).or_insert(RenderElementState {
+                visible_area: 0,
+                presentation_state: RenderElementPresentationState::Skipped,
+                needs_capture: false,
+            });
+        }
+    }
+    states
+}
