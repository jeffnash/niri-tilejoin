+/// Applies connector properties to both physical links in one atomic transaction.
+///
+/// All requested values are preflighted before the request is built, so a bad range or missing
+/// configured property on either member cannot leave the two halves in different states.
+fn set_tiled_connector_properties(
+    device: &DrmDevice,
+    connectors: [connector::Handle; 2],
+    max_bpc: Option<MaxBpc>,
+    reset_hdr: bool,
+) -> anyhow::Result<bool> {
+    let mut planned = Vec::with_capacity(2);
+    for connector in connectors {
+        let props = ConnectorProperties::try_new(device, connector)
+            .with_context(|| format!("failed to read connector properties for {connector:?}"))?;
+        let mut changes = Vec::new();
+        if let Some(max_bpc) = max_bpc {
+            if let Some(change) = props
+                .max_bpc_change(max_bpc)
+                .with_context(|| format!("invalid max-bpc for connector {connector:?}"))?
+            {
+                changes.push(change);
+            }
+        }
+        if reset_hdr {
+            changes.extend(
+                props.hdr_reset_changes().with_context(|| {
+                    format!("invalid HDR properties for connector {connector:?}")
+                })?,
+            );
+        }
+        planned.push((connector, changes));
+    }
+
+    let changed = planned.iter().any(|(_, changes)| !changes.is_empty());
+    if changed {
+        let mut request = AtomicModeReq::new();
+        for (connector, changes) in planned {
+            for (handle, value) in changes {
+                request.add_raw_property(connector.into(), handle, value);
+            }
+        }
+        device.atomic_commit(AtomicCommitFlags::ALLOW_MODESET, request)?;
+    }
+    Ok(changed)
+}
