+/// Tears down the tiled group containing `crtc` (any member crtc), removing its logical
+/// output. The members can come up separately only after disabling both heads was confirmed.
+fn tiled_group_teardown(
+    device: &mut OutputDevice,
+    crtc_events: &mut HashMap<(DrmNode, crtc::Handle), CrtcEventTracker>,
+    niri: &mut Niri,
+    node: DrmNode,
+    crtc: crtc::Handle,
+) {
+    let Some((primary, mut group)) = device.tilejoin.take_live_group_by_member(crtc) else {
+        error!("tiled-groups: missing group for member crtc {crtc:?}");
+        return;
+    };
+    for member in &group.members {
+        crtc_events
+            .entry((node, member.crtc))
+            .or_default()
+            .begin_generation();
+    }
+
+    debug!(
+        "tiled-groups: tearing down tiled group: {}",
+        group.name.connector
+    );
+
+    // Stop lifecycle callbacks before attempting the all-head disable. On failure the complete
+    // group moves into quarantine, retaining every potentially scanned-out resource.
+    group.cancel_completion_watchdog(&niri.event_loop);
+    let disable_result = if device.drm.is_active() {
+        group.clear(&device.drm, &niri.event_loop).map(|_| ())
+    } else {
+        Err(anyhow!("DRM device is inactive"))
+    };
+
+    match disable_result {
+        Ok(()) => {
+            destroy_tiled_gamma_blobs(&device.drm, &mut group);
+            group.destroy(&device.drm);
+        }
+        Err(err) => {
+            let key = group.name.connector.clone();
+            let policy = record_tiled_failure(
+                device.tilejoin.disable_failures_mut(),
+                TiledFailureScope::Disable,
+                device.drm.is_active(),
+                &niri.event_loop,
+                node,
+                key.clone(),
+                TiledFailureClass::Retryable,
+            );
+            warn!(
+                "tiled-groups: could not confirm disable for {key}: {err:?}; retaining both \
+                 member CRTCs in quarantine; failure policy: {policy:?}"
+            );
+            device.tilejoin.quarantine_group(primary, group);
+        }
+    }
+
+    let output = tiled_output(niri, node, primary);
+    if let Some(output) = output {
+        niri.remove_output(&output);
+    } else {
+        error!("missing output for tiled group primary crtc {primary:?}");
+    };
+}
+
+fn tiled_output(niri: &Niri, node: DrmNode, primary: crtc::Handle) -> Option<Output> {
+    niri.global_space
+        .outputs()
+        .find(|output| {
+            let tty_state: &TtyOutputState = output.user_data().get().unwrap();
+            tty_state.node == node && tty_state.crtc == primary
+        })
+        .cloned()
+}
+
+fn abandon_tiled_output_frame(niri: &mut Niri, node: DrmNode, primary: crtc::Handle) {
+    if let Some(output) = tiled_output(niri, node, primary) {
+        niri.abandon_output_frame(&output);
+    } else {
+        error!("missing output while abandoning tiled frame on primary crtc {primary:?}");
+    }
+}
