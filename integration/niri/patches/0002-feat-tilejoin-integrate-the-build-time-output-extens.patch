+#[derive(Debug, Clone, Copy)]
+pub(super) enum DisplayGroupFailureScope {
+    Formation,
+    Disable,
+}
+
+pub(super) fn display_group_plan_matches(live: &LiveDisplayGroup, plan: &OutputGroupPlan) -> bool {
+    live.plan.key == plan.key
+        && live.plan.name == plan.name
+        && match (&live.plan.config, &plan.config) {
+            (Some(a), Some(b)) => a.equivalent(b),
+            (None, None) => true,
+            _ => false,
+        }
+        && live.plan.primary == plan.primary
+        && live.plan.size == plan.size
+        && live.plan.refresh_sync == plan.refresh_sync
+        && live.plan.composited_only == plan.composited_only
+        && configured_scale_matches(live.plan.configured_scale, plan.configured_scale)
+        && live.plan.members.len() == plan.members.len()
+        && live.plan.members.iter().zip(&plan.members).all(|(a, b)| {
+            a.node == b.node
+                && a.connector.handle() == b.connector.handle()
+                && a.crtc == b.crtc
+                && a.mode == b.mode
+                && a.transform == b.transform
+                && a.rect == b.rect
+        })
+}
+
+pub(super) fn display_group_physical_size(plan: &OutputGroupPlan) -> Option<(u32, u32)> {
+    let primary = &plan.members[plan.primary];
+    if primary.rect.width == 0 || primary.rect.height == 0 {
+        return None;
+    }
+    let (mut width, mut height) = primary.connector.size()?;
+    if matches!(
+        primary.transform,
+        niri_ipc::Transform::_90
+            | niri_ipc::Transform::_270
+            | niri_ipc::Transform::Flipped90
+            | niri_ipc::Transform::Flipped270
+    ) {
+        mem::swap(&mut width, &mut height);
+    }
+    Some((
+        width
+            .saturating_mul(plan.size.width)
+            .checked_div(primary.rect.width)?,
+        height
+            .saturating_mul(plan.size.height)
+            .checked_div(primary.rect.height)?,
+    ))
+}
+
+pub(super) fn record_failure_with_retry(
+    failures: &mut TiledFailureTracker,
+    drm_active: bool,
+    event_loop: &LoopHandle<'static, State>,
+    key: String,
+    mut class: TiledFailureClass,
+    retry_callback: impl FnOnce(&mut State, &str, u64) + 'static,
+) -> TiledFailurePolicy {
+    if !drm_active {
+        class = TiledFailureClass::UntilSessionResume;
+    }
+
+    let retry = failures.record(key.clone(), class, Instant::now());
+    if let Some(retry) = retry {
+        let timer_key = key.clone();
+        let mut retry_callback = Some(retry_callback);
+        event_loop
+            .insert_source(Timer::from_duration(retry.delay), move |_, _, state| {
+                retry_callback.take().unwrap()(state, &timer_key, retry.generation);
+                TimeoutAction::Drop
+            })
+            .unwrap();
+    }
+
+    failures.policy(&key).unwrap()
+}
+
+pub(super) fn record_display_group_failure(
+    failures: &mut TiledFailureTracker,
+    scope: DisplayGroupFailureScope,
+    drm_active: bool,
+    event_loop: &LoopHandle<'static, State>,
+    key: String,
+    class: TiledFailureClass,
+) -> TiledFailurePolicy {
+    record_failure_with_retry(
+        failures,
+        drm_active,
+        event_loop,
+        key,
+        class,
+        move |state, key, generation| display_group_failure_retry(state, scope, key, generation),
+    )
+}
+
+fn display_group_failure_retry(
+    state: &mut State,
+    scope: DisplayGroupFailureScope,
+    key: &str,
+    generation: u64,
+) {
+    let retry_due = {
+        let manager = &state.backend.tty().display_groups;
+        let failures = match scope {
+            DisplayGroupFailureScope::Formation => &manager.formation_failures,
+            DisplayGroupFailureScope::Disable => &manager.disable_failures,
+        };
+        failures.retry_due(key, generation, Instant::now())
+    };
+    if !retry_due {
+        return;
+    }
+
+    debug!("display-group {key}: retrying {scope:?} operation");
+    if matches!(scope, DisplayGroupFailureScope::Formation) {
+        state
+            .backend
+            .tty()
+            .reconcile_output_config(&mut state.niri, None);
+        return;
+    }
+
+    // A watchdog failure can leave the live plan unchanged. Reconciliation alone would reuse that
+    // matching group forever, so disable retries must retry the retained teardown transaction
+    // directly.
+    match state
+        .backend
+        .tty()
+        .display_group_teardown(&mut state.niri, key)
+    {
+        Ok(()) => {
+            state
+                .backend
+                .tty()
+                .display_groups
+                .disable_failures
+                .remove(key);
+            state
+                .backend
+                .tty()
+                .reconcile_output_config(&mut state.niri, None);
+        }
+        Err(err) => {
+            let members = state
+                .backend
+                .tty()
+                .display_groups
+                .retained_group(key)
+                .map(|group| group.plan.members.clone())
+                .unwrap_or_default();
+            let drm_active = members.iter().all(|member| {
+                state
+                    .backend
+                    .tty()
+                    .devices
+                    .get(&member.node)
+                    .is_some_and(|device| device.drm.is_active())
+            });
+            let policy = record_display_group_failure(
+                &mut state.backend.tty().display_groups.disable_failures,
+                DisplayGroupFailureScope::Disable,
+                drm_active,
+                &state.niri.event_loop,
+                key.to_owned(),
+                TiledFailureClass::Retryable,
+            );
+            warn!(
+                "display-group {key}: retained teardown retry failed: {err:?}; failure policy: {policy:?}"
+            );
+        }
+    }
+}
