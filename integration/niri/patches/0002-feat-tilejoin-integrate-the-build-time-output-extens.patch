+/// Snapshots device-removal work before any teardown mutates the tiled indexes.
+fn device_disconnect_targets<C>(
+    crtcs: impl IntoIterator<Item = C>,
+    mut tiled_primary: impl FnMut(C) -> Option<C>,
+) -> Vec<DeviceDisconnectTarget<C>>
+where
+    C: Copy + Eq + std::hash::Hash,
+{
+    let mut seen_groups = HashSet::new();
+    crtcs
+        .into_iter()
+        .filter_map(|crtc| match tiled_primary(crtc) {
+            Some(primary) if seen_groups.insert(primary) => {
+                Some(DeviceDisconnectTarget::TiledGroup(primary))
+            }
+            Some(_) => None,
+            None => Some(DeviceDisconnectTarget::Crtc(crtc)),
+        })
+        .collect()
+}
