+#[derive(Debug)]
+struct PersistentTiledConnectError(anyhow::Error);
+
+impl fmt::Display for PersistentTiledConnectError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{:#}", self.0)
+    }
+}
+
+impl std::error::Error for PersistentTiledConnectError {}
+
+fn persistent_tiled_connect_error(error: anyhow::Error) -> anyhow::Error {
+    anyhow::Error::new(PersistentTiledConnectError(error))
+}
+
+fn classify_tiled_test_only_failure(error: &io::Error) -> TiledFailureClass {
+    if matches!(
+        error.raw_os_error(),
+        Some(
+            libc::EACCES
+                | libc::EAGAIN
+                | libc::EBUSY
+                | libc::EINTR
+                | libc::EIO
+                | libc::ENOMEM
+                | libc::ETIMEDOUT
+        )
+    ) {
+        TiledFailureClass::Retryable
+    } else {
+        // EINVAL and unsupported/property/layout failures are stable for an unchanged KMS
+        // fingerprint. Retrying them on a timer only repeats the same modeset rejection.
+        TiledFailureClass::UntilEnvironmentChange
+    }
+}
+
+fn classify_tiled_connect_test_error(error: io::Error) -> anyhow::Error {
+    let class = classify_tiled_test_only_failure(&error);
+    let error = anyhow!("tiled TEST_ONLY commit failed: {error}");
+    if class == TiledFailureClass::UntilEnvironmentChange {
+        persistent_tiled_connect_error(error)
+    } else {
+        error
+    }
+}
