+enum TiledDirectScanoutRejection {
+    Disabled,
+    NeedsModeset,
+    NoVisibleElement,
+    OverlayOrCursor,
+    Dimensions,
+    TransformOrScale,
+    Opacity,
+    UnsupportedStorage,
+    DeviceMismatch,
