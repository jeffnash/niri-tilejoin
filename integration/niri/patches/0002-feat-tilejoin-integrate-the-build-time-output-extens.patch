+    fn connector_disconnected(&mut self, niri: &mut Niri, node: DrmNode, crtc: crtc::Handle) {
+        if let Some((key, _)) = self.display_groups.member(node, crtc) {
+            let key = key.to_owned();
+            if let Err(err) = self.display_group_teardown(niri, &key) {
+                let drm_active = self
+                    .display_groups
+                    .retained_group(&key)
+                    .is_some_and(|group| {
+                        group.plan.members.iter().all(|member| {
+                            self.devices
+                                .get(&member.node)
+                                .is_some_and(|device| device.drm.is_active())
+                        })
+                    });
+                let policy = record_display_group_failure(
+                    &mut self.display_groups.disable_failures,
+                    DisplayGroupFailureScope::Disable,
+                    drm_active,
+                    &niri.event_loop,
+                    key.clone(),
+                    TiledFailureClass::Retryable,
+                );
+                warn!(
+                    "display-group {key}: teardown retained for retry: {err:?}; failure policy: {policy:?}"
+                );
+            }
+            return;
+        }
+        let Some(device) = self.devices.get_mut(&node) else {
+            debug!("disconnecting connector for crtc: {crtc:?}");
+            error!("missing device");
+            return;
+        };
+
+        // A member of a tiled group tears down the whole group.
+        if device.tilejoin.owns_crtc(crtc) {
+            tiled_group_teardown(device, &mut self.crtc_events, niri, node, crtc);
+            return;
+        }
+
+        // A quarantined member remains owned by its failed all-head teardown until a later
+        // successful disable or device removal.
+        if device.tiled_crtc_quarantined(crtc) {
+            debug!("tiled-groups: quarantined member disconnected: {crtc:?}");
+            return;
+        }
+
+        self.crtc_events
+            .entry((node, crtc))
+            .or_default()
+            .replace_compositor();
+        let Some(mut surface) = device.surfaces.remove(&crtc) else {
+            debug!("disconnecting connector for crtc: {crtc:?}");
+
+            if let Some((conn, _)) = device
+                .non_desktop_connectors
+                .iter()
+                .find(|(_, crtc_)| *crtc_ == crtc)
+            {
+                debug!("withdrawing non-desktop connector from DRM leasing");
+
+                let conn = *conn;
+                device.non_desktop_connectors.remove(&(conn, crtc));
+
+                if let Some(lease_state) = &mut device.drm_lease_state {
+                    lease_state.withdraw_connector(conn);
+                }
+            } else {
+                debug!("crtc wasn't enabled");
+            }
+
+            return;
+        };
+        if let Some(gamma_props) = &mut surface.gamma_props {
+            gamma_props.destroy(&device.drm);
+        }
+
+        debug!("disconnecting connector: {:?}", surface.name.connector);
+
+        let output = niri
+            .global_space
+            .outputs()
+            .find(|output| {
+                let tty_state: &TtyOutputState = output.user_data().get().unwrap();
+                tty_state.node == node && tty_state.crtc == crtc
+            })
+            .cloned();
+        if let Some(output) = output {
+            niri.remove_output(&output);
+        } else {
+            error!("missing output for crtc {crtc:?}");
+        };
+    }
