+
+impl DisplayGroupManager {
+    pub(super) fn next_generation(&mut self) -> u64 {
+        self.generation = self.generation.wrapping_add(1).max(1);
+        self.generation
+    }
+
+    pub(super) fn member(&self, node: DrmNode, crtc: crtc::Handle) -> Option<(&str, usize)> {
+        self.by_member
+            .get(&(node, crtc))
+            .map(|(key, member)| (key.as_str(), *member))
+    }
+
+    pub(super) fn owns(&self, node: DrmNode, crtc: crtc::Handle) -> bool {
+        self.by_member.contains_key(&(node, crtc))
+    }
+
+    pub(super) fn output_id(&mut self, key: &str) -> OutputId {
+        *self
+            .ids
+            .entry(key.to_owned())
+            .or_insert_with(OutputId::next)
+    }
+
+    pub(super) fn insert(&mut self, group: LiveDisplayGroup) {
+        let key = group.plan.key.clone();
+        assert!(!self.quarantined.contains_key(&key));
+        for (member, plan) in group.plan.members.iter().enumerate() {
+            assert!(self
+                .by_member
+                .insert((plan.node, plan.crtc), (key.clone(), member))
+                .is_none());
+        }
+        assert!(self.groups.insert(key, group).is_none());
+    }
+
+    pub(super) fn quarantine_live(&mut self, key: &str) -> Option<&mut QuarantinedDisplayGroup> {
+        let group = self.groups.remove(key)?;
+        let (lifecycle, commands) = GroupTeardownLifecycle::begin(group.plan.members.len());
+        debug_assert_eq!(
+            commands,
+            [
+                TeardownCommand::WithdrawOutput,
+                TeardownCommand::EnterQuarantine
+            ]
+        );
+        assert!(self
+            .quarantined
+            .insert(
+                key.to_owned(),
+                QuarantinedDisplayGroup {
+                    group,
+                    lifecycle,
+                    retry_token: None,
+                    entered_at: Instant::now(),
+                },
+            )
+            .is_none());
+        self.quarantined.get_mut(key)
+    }
+
+    pub(super) fn finish_quarantine(&mut self, key: &str) -> Option<LiveDisplayGroup> {
+        let quarantine = self.quarantined.remove(key)?;
+        for member in &quarantine.group.plan.members {
+            self.by_member.remove(&(member.node, member.crtc));
+        }
+        Some(quarantine.group)
+    }
+
+    pub(super) fn retained_group(&self, key: &str) -> Option<&LiveDisplayGroup> {
+        self.groups
+            .get(key)
+            .or_else(|| self.quarantined.get(key).map(|entry| &entry.group))
+    }
+}
