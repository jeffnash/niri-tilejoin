+/// Computes the tiled groups that should exist on a device, from explicit `tiled-group`
+/// config entries and (if `auto`) TILE-topology auto-detection.
+///
+/// Returns the plans, the crtcs that must not be connected individually, and the crtcs that
+/// must be disconnected (members of explicitly configured groups that are off).
+fn plan_tiled_groups(
+    device: &OutputDevice,
+    node: DrmNode,
+    config: &Config,
+    auto: bool,
+) -> (
+    Vec<TiledGroupPlan>,
+    HashSet<crtc::Handle>,
+    Vec<crtc::Handle>,
+) {
+    // Niri owns discovery because its scanner also tracks non-desktop and leased connectors.
+    // Pairing, explicit-config precedence, and auto-detection live in `niri-tiled`.
+    let mut connected = Vec::new();
+    for (connector, crtc) in device.drm_scanner.crtcs() {
+        if connector.state() != connector::State::Connected {
+            continue;
+        }
+        if device
+            .non_desktop_connectors
+            .contains(&(connector.handle(), crtc))
+            || is_non_desktop(&device.drm, connector.handle())
+        {
+            continue;
+        }
+        let connector_name = format_connector_name(connector);
+        let output_name = make_output_name(&device.drm, connector.handle(), connector_name);
+        connected.push(ConnectedTile {
+            connector: connector.clone(),
+            crtc,
+            name: output_name,
+        });
+    }
+    let occupied_crtcs = device
+        .surfaces
+        .keys()
+        .copied()
+        .chain(device.tilejoin.occupied_crtcs())
+        .collect();
+    let result =
+        plan_native_tiled_groups(&device.drm, node, config, &connected, &occupied_crtcs, auto);
+    (result.plans, result.consumed_crtcs, result.force_disconnect)
+}
+
+/// Finds the exact config declaration bound while planning a tiled group, falling back to the
+/// synthesized output identity if that declaration has since disappeared.
+fn tiled_group_config<'a>(
+    config: &'a Config,
+    group_name: &OutputName,
+    binding: Option<&OutputConfigBinding>,
+) -> Option<&'a niri_config::Output> {
+    config.outputs.find_bound(group_name, binding)
+}
+
 fn is_vrr_capable(device: &DrmDevice, connector: connector::Handle) -> Option<bool> {
     let (_, info, value) = find_drm_property(device, connector, "vrr_capable")?;
     info.value_type().convert_value(value).as_boolean()
 }
 
+fn is_non_desktop(device: &DrmDevice, connector: connector::Handle) -> bool {
+    find_drm_property(device, connector, "non-desktop")
+        .and_then(|(_, info, value)| info.value_type().convert_value(value).as_boolean())
+        .unwrap_or(false)
+}
