+}
+
+pub(super) fn display_group_requires_composition(
+    scanout: impl IntoIterator<Item = Option<DisplayGroupScanoutKind>>,
+) -> bool {
+    let mut saw_direct = false;
+    let mut saw_composited = false;
+    for kind in scanout {
+        match kind {
+            Some(DisplayGroupScanoutKind::Direct) => saw_direct = true,
+            Some(DisplayGroupScanoutKind::Composited) | None => saw_composited = true,
+        }
+    }
+    saw_composited && saw_direct
+}
