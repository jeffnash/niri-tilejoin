+fn record_tiled_failure(
+    failures: &mut TiledFailureTracker,
+    scope: TiledFailureScope,
+    drm_active: bool,
+    event_loop: &LoopHandle<'static, State>,
+    node: DrmNode,
+    key: String,
+    class: TiledFailureClass,
+) -> TiledFailurePolicy {
+    record_failure_with_retry(
+        failures,
+        drm_active,
+        event_loop,
+        key,
+        class,
+        move |state, key, generation| tiled_failure_retry(state, node, scope, key, generation),
+    )
+}
+
+fn tiled_failure_retry(
+    state: &mut State,
+    node: DrmNode,
+    scope: TiledFailureScope,
+    key: &str,
+    generation: u64,
+) {
+    let retry_due = state
+        .backend
+        .tty()
+        .devices
+        .get(&node)
+        .is_some_and(|device| {
+            let failures = match scope {
+                TiledFailureScope::Formation => device.tilejoin.formation_failures(),
+                TiledFailureScope::Disable => device.tilejoin.disable_failures(),
+            };
+            failures.retry_due(key, generation, Instant::now())
+        });
+    if !retry_due {
+        return;
+    }
+
+    debug!("tiled-groups: retrying {scope:?} operation for {key}");
+    state
+        .backend
+        .tty()
+        .reconcile_output_config(&mut state.niri, Some(node));
+}
+
+fn retry_quarantined_tiled_groups(
+    device: &mut OutputDevice,
+    event_loop: &LoopHandle<'static, State>,
+    node: DrmNode,
+) {
+    if !device.drm.is_active() {
+        return;
+    }
+
+    let now = Instant::now();
+    let ready = device
+        .tilejoin
+        .quarantined_groups()
+        .filter_map(|(&primary, group)| {
+            (!device
+                .tilejoin
+                .disable_failures()
+                .blocks(&group.name.connector, now))
+            .then_some(primary)
+        })
+        .collect::<Vec<_>>();
+
+    for primary in ready {
+        let Some(mut group) = device.tilejoin.take_quarantined_group(primary) else {
+            continue;
+        };
+        let key = group.name.connector.clone();
+
+        match group.clear(&device.drm, event_loop) {
+            Ok(_) => {
+                debug!("tiled-groups: confirmed delayed disable for {key}");
+                device.tilejoin.disable_failures_mut().remove(&key);
+                destroy_tiled_gamma_blobs(&device.drm, &mut group);
+                group.destroy(&device.drm);
+            }
+            Err(err) => {
+                group.cancel_completion_watchdog(event_loop);
+                let policy = record_tiled_failure(
+                    device.tilejoin.disable_failures_mut(),
+                    TiledFailureScope::Disable,
+                    true,
+                    event_loop,
+                    node,
+                    key.clone(),
+                    TiledFailureClass::Retryable,
+                );
+                warn!(
+                    "tiled-groups: delayed disable still failed for {key}: {err:?}; \
+                     failure policy: {policy:?}"
+                );
+                device.tilejoin.quarantine_group(primary, group);
+            }
+        }
+    }
+}
